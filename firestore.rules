rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. PERFILES DE USUARIO (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer datos públicos (para listas de amigos, ranking y perfil)
      allow read: if isAuthenticated();

      // Creación inicial del perfil tras registrarse
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt'])
                    && request.resource.data.uid == userId;

      // Actualización de perfil: El dueño puede editar cosméticos, nivel, inventario, monedas y poder de colección.
      // BLOQUEO: gemas y contadores de sobres gratuitos
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'gems', 
                        'availablePacks', 
                        'packsOpenedTotal',
                        'lastFreePackClaimAt',
                        'adsWatchedTodayCount',
                        'lastAdWatchedDate'
                      ]));

      allow delete: if false; // Prohibido borrar perfiles desde el cliente

      // =========================================================================
      // 2. INVENTARIO DE CARTAS (/users/{userId}/collection/{cardId})
      // =========================================================================
      match /collection/{cardId} {
        // Solo el dueño puede leer su inventario completo
        allow read: if isOwner(userId);
        
        // BLOQUEO TOTAL: Ningún cliente puede añadir o restar cartas directamente.
        // Toda modificación pasa autoritativamente por Cloud Functions (openPack, mercado, trading).
        allow write: if false;
      }
    }

    // =========================================================================
    // 3. CATÁLOGOS PÚBLICOS (Solo lectura)
    // =========================================================================
    match /cardsCatalog/{cardId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /albums/{albumId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /packs/{packId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /datapacks_catalog/{packId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // 4. HISTORIAL DE AUDITORÍA Y TRANSACCIONES (/transactions/{txId})
    // =========================================================================
    match /transactions/{txId} {
      // El jugador solo puede consultar sus propias transacciones pasadas
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Inmutable: Solo Cloud Functions pueden escribir
      allow write: if false;
    }

    // =========================================================================
    // 5. MERCADO DE CARTAS ENTRE JUGADORES (/marketListings/{listingId})
    // TDD Secciones 2.11, 5.8b, 7 y GDD Sección 7.1
    // =========================================================================

    // Validación de esquema y restricciones de integridad para listados de mercado
    function isValidMarketListing(data) {
      return data.keys().hasAll([
               'listingId', 'sellerUid', 'sellerDisplayName', 
               'cardId', 'cardName', 'rarity', 
               'quantity', 'pricePerCard', 'status', 'createdAt'
             ])
             && data.listingId is string
             && data.sellerUid is string
             && data.sellerDisplayName is string
             && data.cardId is string
             && data.cardName is string
             && data.rarity in ['comun', 'poco_comun', 'rara', 'legendaria', 'mitica', 'full_art']
             && data.quantity is int
             && data.quantity > 0
             && data.pricePerCard is int
             && data.pricePerCard > 0
             && data.status in ['activo', 'vendido', 'cancelado']
             && data.createdAt is timestamp;
    }

    match /marketListings/{listingId} {
      // Lectura pública: Cualquier usuario autenticado puede explorar cartas a la venta
      allow read: if isAuthenticated();

      // Creación: El vendedor autenticado crea el listado con su propio sellerUid
      allow create: if isAuthenticated() && request.resource.data.sellerUid == request.auth.uid;

      // Actualización:
      // 1. El vendedor puede modificar el precio o cancelar el listado
      // 2. Un comprador autenticado puede marcar la carta como 'vendida' asignando su buyerUid
      allow update: if isAuthenticated() && (
        resource.data.sellerUid == request.auth.uid ||
        request.resource.data.buyerUid == request.auth.uid ||
        resource.data.buyerUid == request.auth.uid
      );

      // Eliminación o limpieza por parte del vendedor
      allow delete: if isAuthenticated() && resource.data.sellerUid == request.auth.uid;
    }

    // =========================================================================
    // 6. OFERTAS DE INTERCAMBIO (/tradeOffers/{tradeId})
    // TDD Secciones 2.5, 5.8, 7 y 7.2: Intercambio directo anti-fraude
    // =========================================================================

    // Validación de esquema de datos para tradeOffers (TDD Sección 5.8 y 7.2)
    function isValidTradeOffer(data) {
      return data.keys().hasAll([
               'tradeId', 'fromUid', 'toUid', 
               'offeredCardId', 'offeredQty', 
               'requestedCardId', 'requestedQty', 
               'status', 'expiresAt'
             ])
             && data.tradeId is string
             && data.fromUid is string
             && data.toUid is string
             && data.fromUid != data.toUid
             && data.offeredCardId is string
             && data.offeredQty is int
             && data.offeredQty > 0
             && data.requestedCardId is string
             && data.requestedQty is int
             && data.requestedQty > 0
             && data.status in ['pendiente', 'aceptado', 'rechazado', 'cancelado', 'expirado']
             && data.expiresAt is timestamp;
    }

    match /tradeOffers/{tradeId} {
      // Lectura privada: Solo el proponente o el receptor pueden ver la oferta
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );

      // Creación: El proponente autenticado crea la oferta
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;

      // Actualización o cancelación: Solo las partes involucradas
      allow update, delete: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid || 
        resource.data.fromUid == request.auth.uid
      );
    }

    // =========================================================================
    // 7. REGISTROS DE IDEMPOTENCIA (/processedRequests/{requestId})
    // =========================================================================
    match /processedRequests/{requestId} {
      // Privado exclusivo del servidor: Denegado por defecto a clientes
      allow read: if false;
      allow write: if false;
    }

    // =========================================================================
    // 8. DATA PACKS DE LA COMUNIDAD (/dataPacks/{packId})
    // =========================================================================
    match /dataPacks/{packId} {
      // Solo se pueden leer si están 'aprobados', o si eres el creador del pack
      allow read: if resource.data.status == 'aprobado' || (
        isAuthenticated() && resource.data.uploaderUid == request.auth.uid
      );
      // Creación/Edición validada por Cloud Functions
      allow write: if false;
    }

    // =========================================================================
    // 9. MISIONES DE USUARIO (/userMissions/{userMissionId})
    // =========================================================================
    match /userMissions/{userMissionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // =========================================================================
    // 10. SOLICITUDES DE AMISTAD (/friendRequests/{requestId})
    // =========================================================================
    match /friendRequests/{requestId} {
      // Permite leer si eres el remitente o el destinatario
      allow read: if isAuthenticated();
      // Permite crear si estás autenticado y eres el remitente
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      // Permite actualizar o eliminar al remitente o destinatario (para aceptar, rechazar o cancelar)
      allow update, delete: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid || 
        resource.data.fromUid == request.auth.uid
      );
    }

    // =========================================================================
    // 11. VITRINAS PÚBLICAS (/vitrines/{userId})
    // =========================================================================
    match /vitrines/{userId} {
      // Lectura pública: Cualquier usuario autenticado puede ver las vitrinas
      allow read: if isAuthenticated();

      // Creación: Solo el dueño de la cuenta puede crear su vitrina
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Actualización:
      // 1. El dueño puede actualizar sus cartas expuestas y datos de perfil
      // 2. Cualquier usuario autenticado puede dar o quitar 'Like' actualizando 'likesCount' y 'likedBy'
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
      );

      // Eliminación: Solo el dueño
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

  }
}

