/* ==========================================================================
   MY CARDS SCREEN - UI TOOLKIT USS (1080x2400 Figma 1:1 Mobile Layout)
   Figma Fidelity: Docs/Pantallas 2.2 App.tsx lines 740-890
   ========================================================================== */

:root {
    --dark-bg: #07120B;
    --card-bg: #0D1A13;
    --gold: #E8A820;
    --gold-border: #D4960E;
    --gold-bg: rgba(232, 168, 32, 0.12);
    --border-subtle: rgba(255, 255, 255, 0.13);
    --text-white: #FFFFFF;
    --text-gray: rgba(255, 255, 255, 0.60);
    --text-dim: rgba(255, 255, 255, 0.38);

    --rarity-mythic: #E8A820;
    --rarity-rare: #9B5CF6;
    --rarity-uncommon: rgba(180, 200, 195, 0.75);
    --rarity-uncommon-border: rgba(180, 200, 195, 0.55);
    --rarity-common: #27C96A;
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--dark-bg);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
    position: relative;
    padding-top: 140px;
    padding-left: 44px;
    padding-right: 44px;
    padding-bottom: 0;
}

#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}

/* ==========================================================================
   HEADER & TITLE
   ========================================================================== */
.cards-header {
    width: 100%;
    margin-bottom: 20px;
}

.cards-title {
    font-size: 60px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 5px;
    margin-bottom: 28px;
}

/* ==========================================================================
   HORIZONTAL FILTER BAR (76px DE ALTO, CÁPSULAS TÁCTILES FIGMA)
   ========================================================================== */
.filter-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    height: 96px;
    width: 100%;
}

.filter-arrow-btn {
    width: 56px;
    height: 76px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.filter-arrow-btn:active {
    scale: 0.90;
}

.filter-arrow-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
}

.filter-scroll {
    flex-grow: 1;
    flex-direction: row;
    height: 96px;
}

.filter-scroll #unity-content-container {
    flex-direction: row;
    align-items: center;
}

.filter-pill {
    height: 76px;
    padding-left: 36px;
    padding-right: 36px;
    border-radius: 38px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    transition-property: scale;
    transition-duration: 0.12s;
}

.filter-pill:active {
    scale: 0.94;
}

.filter-pill-active {
    background-color: var(--gold-bg);
    border-color: var(--gold-border);
}

.filter-pill-text {
    font-size: 30px;
    color: var(--text-gray);
    letter-spacing: 1px;
}

.filter-pill-text-active {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 1px;
}

/* ==========================================================================
   COUNTER & SEARCH ROW (80px DE ALTO)
   ========================================================================== */
.meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    margin-bottom: 28px;
    width: 100%;
}

.cards-count-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-gray);
    letter-spacing: 1px;
}

.search-box {
    flex-direction: row;
    align-items: center;
    width: 480px;
    height: 74px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 37px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding-left: 22px;
    padding-right: 22px;
}

.search-icon {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_search.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
    margin-right: 12px;
}

.search-text-field {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: var(--text-white);
    font-size: 28px;
    padding: 0;
}

.search-text-field > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-white);
    font-size: 28px;
    padding: 0;
}

/* ==========================================================================
   CARDS GRID SCROLL (2 Columnas - Tarjetas 680px Figma 1:1)
   ========================================================================== */
.cards-scroll-view {
    flex-grow: 1;
    width: 100%;
    position: relative;
    overflow: hidden;
}

.cards-scroll-view #unity-content-container {
    padding-bottom: 260px;
    padding-right: 18px;
    width: 100%;
}

.cards-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

/* Card Item (2 Columnas: 48.5% ancho, 680px alto) */
.card-item {
    width: 48.5%;
    height: 680px;
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 2px;
    margin-bottom: 28px;
    align-items: center;
    justify-content: space-between;
    padding-top: 38px;
    padding-bottom: 30px;
    padding-left: 20px;
    padding-right: 20px;
}

.card-item:active {
    opacity: 0.88;
}

/* ==========================================================================
   BORDES DE RAREZA
   ========================================================================== */
.card-comun,
.card-common {
    border-color: #CBD5E1;
    background-color: rgba(203, 213, 225, 0.06);
}

.card-especial,
.card-uncommon {
    border-color: #00FF73;
    background-color: rgba(0, 255, 115, 0.06);
}

.card-epica,
.card-rare {
    border-color: #BF00FF;
    background-color: rgba(191, 0, 255, 0.06);
}

.card-legendaria {
    border-color: #FFD700;
    background-color: rgba(255, 215, 0, 0.08);
}

.card-mitica,
.card-mythic {
    border-color: #FF2535;
    background-color: rgba(255, 37, 53, 0.08);
}

.card-fullart {
    border-color: #00E5FF;
    background-color: rgba(0, 229, 255, 0.08);
}

/* ==========================================================================
   CARD AVATAR / INITIALS (176px DE DIÁMETRO FIGMA)
   ========================================================================== */
.card-avatar-circle {
    width: 176px;
    height: 176px;
    border-radius: 88px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2.5px;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.avatar-comun,
.avatar-common {
    border-color: #CBD5E1;
}

.avatar-especial,
.avatar-uncommon {
    border-color: #00FF73;
}

.avatar-epica,
.avatar-rare {
    border-color: #BF00FF;
}

.avatar-legendaria {
    border-color: #FFD700;
}

.avatar-mitica,
.avatar-mythic {
    border-color: #FF2535;
}

.avatar-fullart {
    border-color: #00E5FF;
}

.card-avatar-initials {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.initials-comun,
.initials-common {
    color: #CBD5E1;
}

.initials-especial,
.initials-uncommon {
    color: #00FF73;
}

.initials-epica,
.initials-rare {
    color: #BF00FF;
}

.initials-legendaria {
    color: #FFD700;
}

.initials-mitica,
.initials-mythic {
    color: #FF2535;
}

.initials-fullart {
    color: #00E5FF;
}

/* Player Name */
.card-player-name {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-white);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

/* Rarity Badge */
.card-rarity-badge {
    font-size: 26px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

/* ==========================================================================
   INTEGRATED MOBILE SCROLLBAR (Figma Sleek Golden Style)
   ========================================================================== */
.cards-scroll-view .unity-scroller--vertical,
.cards-scroll-view #unity-vertical-scroller,
.unity-scroller--vertical {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 2px;
    top: 10px;
    bottom: 240px;
}

/* Ocultar botones de flecha toscos */
.cards-scroll-view .unity-scroller__low-button,
.cards-scroll-view .unity-scroller__high-button,
.cards-scroll-view #unity-low-button,
.cards-scroll-view #unity-high-button,
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Slider contenedor transparente */
.cards-scroll-view .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

/* Pista translúcida muy sutil */
.cards-scroll-view #unity-tracker,
.cards-scroll-view .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

/* Cápsula dorada deslizante estilizada (Figma) */
.cards-scroll-view #unity-dragger,
.cards-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 120px;
    margin: 0;
    opacity: 0.65;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.cards-scroll-view #unity-dragger:hover,
.cards-scroll-view #unity-dragger:active {
    background-color: #FFD257;
    opacity: 1;
}

/* ==========================================================================
   CARD HERO INSPECT / ZOOM MODAL (POKÉMON TCG POCKET STYLE)
   ========================================================================== */
.inspect-overlay,
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 8, 5, 0.93);
    align-items: center;
    justify-content: space-between;
    padding-top: 130px;
    padding-bottom: 70px;
    padding-left: 40px;
    padding-right: 40px;
}

.modal-hidden {
    display: none;
}

/* Top bar */
.inspect-top-bar {
    width: 100%;
    max-width: 820px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-left: 12px;
    padding-right: 12px;
}

.inspect-tilt-hint {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 1px;
}

.inspect-tilt-hint-hidden {
    opacity: 0;
}

.inspect-close-btn {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.22);
    align-items: center;
    justify-content: center;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.inspect-close-btn:hover {
    background-color: rgba(255, 255, 255, 0.20);
    scale: 1.05;
}

.inspect-close-btn:active {
    scale: 0.94;
}

.inspect-close-icon-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

/* Stage & Large Hero Card */
.inspect-card-stage {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
    position: relative;
}

.inspect-hero-card {
    width: 720px;
    height: 1044px;
    border-radius: 46px;
    position: relative;
    overflow: hidden;
    background-color: #071018;
    align-items: center;
    justify-content: center;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.25);
}

.inspect-hero-card.card-comun,
.inspect-hero-card.card-common {
    border-color: #CBD5E1;
}

.inspect-hero-card.card-especial,
.inspect-hero-card.card-uncommon {
    border-color: #00FF73;
}

.inspect-hero-card.card-epica,
.inspect-hero-card.card-rare {
    border-color: #BF00FF;
}

.inspect-hero-card.card-legendaria {
    border-color: #FFD700;
}

.inspect-hero-card.card-mitica,
.inspect-hero-card.card-mythic {
    border-color: #FF2535;
}

.inspect-hero-card.card-fullart {
    border-color: #00E5FF;
}

/* Photo + Frame Art */
.inspect-art-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-radius: 42px;
    overflow: hidden;
}

.inspect-art-photo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.inspect-art-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.inspect-player-name-framed {
    position: absolute;
    bottom: 156px;
    left: 20px;
    right: 20px;
    font-size: 52px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.95);
}

/* Bottom Attributes Row: Flag outside left + Stats inside Frame Box */
.inspect-bottom-row {
    position: absolute;
    bottom: 22px;
    left: 5.4%;
    right: 18%;
    height: 124px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

/* Flag positioned outside the tab on the left, centered in its space */
.inspect-flag-image {
    width: 96px;
    height: 64px;
    border-radius: 4px;
    -unity-background-scale-mode: stretch-to-fill;
    margin-right: 18px;
}

/* The frame footer tab where the stats now live */
.inspect-frame-footer-box {
    flex-grow: 1;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
}

.inspect-stats-group {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
}

.inspect-stat-col {
    align-items: center;
    justify-content: center;
    min-width: 60px;
}

.inspect-stat-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #2b2d42;
    -unity-text-align: middle-center;
    margin-bottom: -2px;
}

.inspect-stat-value {
    font-size: 32px;
    -unity-font-style: bold;
    color: #0c1822;
    -unity-text-align: middle-center;
}

.inspect-art-photo-default {
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: #0c1825;
}

/* Card Grid Placeholder Avatar (Para cartas sin foto en el álbum) */
.card-placeholder-avatar {
    position: absolute;
    top: 36%;
    left: 50%;
    translate: -50% -50%;
    width: 130px;
    height: 130px;
    border-radius: 65px;
    background-color: rgba(22, 34, 52, 0.90);
    border-width: 3.5px;
    border-color: rgba(255, 255, 255, 0.28);
    align-items: center;
    justify-content: center;
}

/* Default Placeholder Avatar (Centered in card when no photo exists) */
.inspect-placeholder-avatar {
    position: absolute;
    top: 36%;
    left: 50%;
    translate: -50% -50%;
    width: 270px;
    height: 270px;
    border-radius: 135px;
    background-color: rgba(22, 34, 52, 0.90);
    border-width: 5px;
    border-color: rgba(255, 255, 255, 0.28);
    align-items: center;
    justify-content: center;
}

.inspect-avatar-initials {
    font-size: 104px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

/* Copies Badge (Top Left to not collide with OVR top-right tab) */
.inspect-copies-badge {
    position: absolute;
    top: 26px;
    left: 26px;
    border-radius: 18px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 30px;
    -unity-font-style: bold;
    background-color: rgba(6, 12, 18, 0.88);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
}

/* Top-Right Overall Rating (GRL) in Hero Card Inspect - Circular Badge */
.inspect-ovr-box {
    position: absolute;
    top: 48px;
    right: 34px;
    width: 92px;
    height: 92px;
    border-radius: 46px;
    background-color: rgba(10, 16, 26, 0.78);
    border-width: 3.5px;
    border-color: rgba(255, 255, 255, 0.45);
    align-items: center;
    justify-content: center;
}

.inspect-ovr-val {
    font-size: 38px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.95);
    margin: 0;
    margin-bottom: -5px;
    padding: 0;
}

.inspect-ovr-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.88);
    -unity-text-align: middle-center;
    letter-spacing: 1.2px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
    margin: 0;
    padding: 0;
}

/* Dismiss Hint */
.inspect-dismiss-hint {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    margin-top: 20px;
}

/* ==========================================================================
   LOCKED CARD SLOTS (ALBUM PILOTO ALPHA)
   ========================================================================== */
.card-locked {
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(10, 16, 12, 0.60);
    opacity: 0.55;
}

.card-locked .card-avatar-circle {
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(0, 0, 0, 0.40);
}

.card-locked .card-avatar-initials {
    color: var(--text-dim);
}

.card-locked .card-player-name {
    color: var(--text-dim);
}

.card-locked .card-rarity-badge {
    background-color: rgba(0, 0, 0, 0.40);
    border-color: rgba(255, 255, 255, 0.10);
    color: var(--text-dim);
}

/* ==========================================================================
   CARD ART & HOLOGRAPHIC FOIL PRESENTATION (Lamine Yamal & Data Packs)
   ========================================================================== */
.card-item-art {
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    overflow: hidden;
    position: relative;
    border-width: 0;
    background-color: #071018;
}

.card-art-container {
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 26px;
    overflow: hidden;
}

.card-art-photo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.card-art-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.card-holo-glint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.65;
}

.card-player-name-framed {
    position: absolute;
    bottom: 96px;
    left: 8px;
    right: 8px;
    font-size: 32px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.95);
}

/* Bottom Attributes Row: Flag outside left + Stats inside Frame Box */
.card-bottom-row {
    position: absolute;
    bottom: 12px;
    left: 5.4%;
    right: 20%;
    height: 76px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

/* Flag outside tab on the left, centered in its space */
.card-flag-image {
    width: 54px;
    height: 36px;
    border-radius: 2px;
    -unity-background-scale-mode: stretch-to-fill;
    margin-right: 10px;
}

/* The frame footer tab where the stats now live */
.card-frame-footer-box {
    flex-grow: 1;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    padding-right: 4px;
}

.card-stats-group {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
}

.card-stat-col {
    align-items: center;
    justify-content: center;
}

.card-stat-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #2b2d42;
    -unity-text-align: middle-center;
    margin-bottom: -3px;
}

.card-stat-value {
    font-size: 19px;
    -unity-font-style: bold;
    color: #0c1822;
    -unity-text-align: middle-center;
}

.card-copies-badge-framed {
    position: absolute;
    top: 14px;
    left: 14px;
    border-radius: 12px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgba(6, 12, 18, 0.82);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
}

/* Top-Right Overall Rating (GRL) in Card Grid - Circular Badge */
.card-ovr-box {
    position: absolute;
    top: 27px;
    right: 19px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(10, 16, 26, 0.78);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
    align-items: center;
    justify-content: center;
}

.card-ovr-val {
    font-size: 21px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
    margin: 0;
    margin-bottom: -3px;
    padding: 0;
}

.card-ovr-title {
    font-size: 8px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.88);
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
    margin: 0;
    padding: 0;
}