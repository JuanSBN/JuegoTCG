/* ==========================================================================
   MY CARDS SCREEN - UI TOOLKIT USS (1080x2400 Figma 1:1 Mobile Layout)
   Figma Fidelity: Docs/Pantallas 2.2 App.tsx lines 740-890
   ========================================================================== */

:root {
    --dark-bg: #07120B;
    --card-bg: #0D1A13;
    --gold: #E8A820;
    --gold-border: #D4960E;
    --gold-bg: rgba(232, 168, 32, 0.12);
    --border-subtle: rgba(255, 255, 255, 0.13);
    --text-white: #FFFFFF;
    --text-gray: rgba(255, 255, 255, 0.60);
    --text-dim: rgba(255, 255, 255, 0.38);

    --rarity-mythic: #E8A820;
    --rarity-rare: #9B5CF6;
    --rarity-uncommon: rgba(180, 200, 195, 0.75);
    --rarity-uncommon-border: rgba(180, 200, 195, 0.55);
    --rarity-common: #27C96A;
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--dark-bg);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
    position: relative;
    padding-top: 140px;
    padding-left: 44px;
    padding-right: 44px;
    padding-bottom: 0;
}

#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}

/* ==========================================================================
   HEADER & TITLE
   ========================================================================== */
.cards-header {
    width: 100%;
    margin-bottom: 20px;
}

.cards-title {
    font-size: 60px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 5px;
    margin-bottom: 28px;
}

/* ==========================================================================
   HORIZONTAL FILTER BAR (76px DE ALTO, CÁPSULAS TÁCTILES FIGMA)
   ========================================================================== */
.filter-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    height: 96px;
    width: 100%;
}

.filter-arrow-btn {
    width: 56px;
    height: 76px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.filter-arrow-btn:active {
    scale: 0.90;
}

.filter-arrow-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
}

.filter-scroll {
    flex-grow: 1;
    flex-direction: row;
    height: 96px;
}

.filter-scroll #unity-content-container {
    flex-direction: row;
    align-items: center;
}

.filter-pill {
    height: 76px;
    padding-left: 36px;
    padding-right: 36px;
    border-radius: 38px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    transition-property: scale;
    transition-duration: 0.12s;
}

.filter-pill:active {
    scale: 0.94;
}

.filter-pill-active {
    background-color: var(--gold-bg);
    border-color: var(--gold-border);
}

.filter-pill-text {
    font-size: 30px;
    color: var(--text-gray);
    letter-spacing: 1px;
}

.filter-pill-text-active {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 1px;
}

/* ==========================================================================
   COUNTER & SEARCH ROW (80px DE ALTO)
   ========================================================================== */
.meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    margin-bottom: 28px;
    width: 100%;
}

.cards-count-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-gray);
    letter-spacing: 1px;
}

.search-box {
    flex-direction: row;
    align-items: center;
    width: 480px;
    height: 74px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 37px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding-left: 22px;
    padding-right: 22px;
}

.search-icon {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_search.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
    margin-right: 12px;
}

.search-text-field {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: var(--text-white);
    font-size: 28px;
    padding: 0;
}

.search-text-field > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-white);
    font-size: 28px;
    padding: 0;
}

/* ==========================================================================
   CARDS GRID SCROLL (2 Columnas - Tarjetas 680px Figma 1:1)
   ========================================================================== */
.cards-scroll-view {
    flex-grow: 1;
    width: 100%;
    position: relative;
}

.cards-scroll-view #unity-content-container {
    padding-bottom: 260px;
    padding-right: 18px;
    width: 100%;
}

.cards-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

/* Card Item (2 Columnas: 48.5% ancho, 680px alto) */
.card-item {
    width: 48.5%;
    height: 680px;
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 2px;
    margin-bottom: 28px;
    align-items: center;
    justify-content: space-between;
    padding-top: 38px;
    padding-bottom: 30px;
    padding-left: 20px;
    padding-right: 20px;
    transition-property: scale;
    transition-duration: 0.15s;
}

.card-item:hover {
    scale: 1.02;
}

.card-item:active {
    scale: 0.96;
}

/* ==========================================================================
   BORDES DE RAREZA
   ========================================================================== */
.card-mythic {
    border-color: var(--rarity-mythic);
    background-color: rgba(232, 168, 32, 0.08);
}

.card-rare {
    border-color: var(--rarity-rare);
    background-color: rgba(155, 92, 246, 0.06);
}

.card-uncommon {
    border-color: var(--rarity-uncommon-border);
    background-color: rgba(180, 200, 195, 0.06);
}

.card-common {
    border-color: var(--rarity-common);
    background-color: rgba(39, 201, 106, 0.06);
}

/* ==========================================================================
   CARD AVATAR / INITIALS (176px DE DIÁMETRO FIGMA)
   ========================================================================== */
.card-avatar-circle {
    width: 176px;
    height: 176px;
    border-radius: 88px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2.5px;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.avatar-mythic {
    border-color: var(--rarity-mythic);
}

.avatar-rare {
    border-color: var(--rarity-rare);
}

.avatar-uncommon {
    border-color: var(--rarity-uncommon-border);
}

.avatar-common {
    border-color: var(--rarity-common);
}

.card-avatar-initials {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.initials-mythic {
    color: var(--rarity-mythic);
}

.initials-rare {
    color: var(--rarity-rare);
}

.initials-uncommon {
    color: var(--rarity-uncommon);
}

.initials-common {
    color: var(--rarity-common);
}

/* Player Name */
.card-player-name {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-white);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

/* Rarity Badge */
.card-rarity-badge {
    font-size: 26px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

/* ==========================================================================
   INTEGRATED MOBILE SCROLLBAR (Figma Sleek Golden Style)
   ========================================================================== */
.cards-scroll-view .unity-scroller--vertical,
.cards-scroll-view #unity-vertical-scroller,
.unity-scroller--vertical {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 2px;
    top: 10px;
    bottom: 240px;
}

/* Ocultar botones de flecha toscos */
.cards-scroll-view .unity-scroller__low-button,
.cards-scroll-view .unity-scroller__high-button,
.cards-scroll-view #unity-low-button,
.cards-scroll-view #unity-high-button,
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Slider contenedor transparente */
.cards-scroll-view .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

/* Pista translúcida muy sutil */
.cards-scroll-view #unity-tracker,
.cards-scroll-view .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

/* Cápsula dorada deslizante estilizada (Figma) */
.cards-scroll-view #unity-dragger,
.cards-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 120px;
    margin: 0;
    opacity: 0.65;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.cards-scroll-view #unity-dragger:hover,
.cards-scroll-view #unity-dragger:active {
    background-color: #FFD257;
    opacity: 1;
}

/* ==========================================================================
   CARD INSPECT / ZOOM MODAL
   ========================================================================== */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 10, 6, 0.85);
    align-items: center;
    justify-content: center;
    padding: 60px;
    z-index: 100;
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 900px;
    background-color: #0c1c12;
    border-radius: 36px;
    border-width: 2px;
    border-color: var(--gold);
    padding: 48px;
    align-items: center;
}

.modal-avatar {
    width: 240px;
    height: 240px;
    border-radius: 120px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 3px;
    border-color: var(--gold);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
}

.modal-initials {
    font-size: 80px;
    -unity-font-style: bold;
    color: var(--gold);
}

.modal-player-name {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--text-white);
    margin-bottom: 12px;
}

.modal-rarity {
    font-size: 30px;
    color: var(--gold);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 36px;
}

.modal-stats-grid {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 24px;
    padding: 24px 16px;
    margin-bottom: 36px;
}

.modal-stat-item {
    align-items: center;
}

.modal-stat-label {
    font-size: 26px;
    color: var(--text-gray);
    margin-bottom: 8px;
}

.modal-stat-val {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--text-white);
}

.modal-close-btn {
    width: 100%;
    height: 94px;
    background-color: var(--gold);
    border-radius: 26px;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.modal-close-btn:active {
    scale: 0.96;
}

.modal-close-btn-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: #07120B;
    letter-spacing: 2px;
}