/* ==========================================================================
   DESIGN TOKENS & FIGMA FIDELITY VARIABLES
   ========================================================================== */
:root {
    --gold: rgb(232, 168, 32);
    --gold-border: rgb(212, 150, 14);
    --card-bg: rgb(13, 26, 19);
    --dark-bg: rgb(9, 19, 13);
    --border-subtle: rgba(255, 255, 255, 0.12);
    --text-white: rgb(255, 255, 255);
    --text-gray: rgba(255, 255, 255, 0.60);
    --text-dim: rgba(255, 255, 255, 0.38);

    /* Rarity Tokens */
    --rarity-mythic: rgb(232, 168, 32);
    --rarity-rare: rgb(173, 94, 240);
    --rarity-uncommon: rgb(180, 200, 195);
    --rarity-common: rgb(39, 201, 106);
}

/* ==========================================================================
   SCREEN CONTAINER (1080x2400 Responsive Flexbox)
   ========================================================================== */
.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--dark-bg);
    background-image: url(project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    position: relative;
}

/* ==========================================================================
   CATALOG VIEW (IMAGEN 2 DE FIGMA)
   ========================================================================== */
.catalog-view {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    padding-top: 140px;
    padding-left: 44px;
    padding-right: 44px;
    padding-bottom: 260px;
}

/* Header */
.catalog-header {
    flex-direction: row;
    align-items: center;
    height: 80px;
    margin-bottom: 28px;
}

.back-btn {
    width: 64px;
    height: 64px;
    background-color: transparent;
    border-width: 0;
    color: var(--text-white);
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin-right: 18px;
}

.catalog-title {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 5px;
}

/* Search Bar (Figma Integrated Design) */
.search-container {
    flex-direction: row;
    align-items: center;
    height: 84px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 42px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding-left: 28px;
    padding-right: 28px;
    margin-bottom: 32px;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.search-container:hover {
    border-color: var(--gold);
    background-color: rgba(255, 255, 255, 0.08);
}

.search-icon {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_search.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-gray);
    margin-right: 16px;
}

.search-input {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

/* Quita el fondo blanco por defecto del componente nativo de Unity */
.search-input > .unity-text-field__input,
.search-input > .unity-base-text-field__input,
.search-input TextInput {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    border-radius: 0;
    color: var(--text-white);
    font-size: 26px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    cursor: text;
}

/* Color sutil e integrado para el texto de marcador (placeholder) */
.search-input .unity-base-text-field__placeholder,
.search-input .unity-text-field__placeholder {
    color: var(--text-dim);
    font-size: 26px;
    -unity-text-align: middle-left;
}

/* Scroll Area */
.catalog-scroll {
    flex-grow: 1;
}

.section-label {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 6px;
    margin-top: 28px;
    margin-bottom: 24px;
}

/* Vitrine Cards Grid (2x2) */
.vitrines-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 28px;
}

/* Individual Vitrine Card in Catalog */
.vitrine-card {
    width: 48.2%;
    height: 380px;
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 24px 22px;
    justify-content: space-between;
    margin-bottom: 24px;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.vitrine-card:active {
    scale: 0.97;
    border-color: var(--gold);
}

.vitrine-card-top {
    flex-direction: row;
    align-items: center;
}

.card-avatar-circle {
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
}

.card-avatar-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-white);
}

.card-username {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--text-white);
}

/* Mini Cards Row Preview */
.mini-cards-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 10px;
    margin-bottom: 10px;
}

.mini-card-preview {
    width: 30%;
    height: 160px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    border-width: 2px;
}

.mini-card-mythic {
    border-color: var(--rarity-mythic);
}

.mini-card-rare {
    border-color: var(--rarity-rare);
}

.mini-card-uncommon {
    border-color: var(--rarity-uncommon);
}

.mini-card-common {
    border-color: var(--rarity-common);
}

/* Card Bottom Likes */
.vitrine-card-bottom {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.catalog-like-icon {
    width: 32px;
    height: 32px;
    background-image: url(project://database/Assets/_Project/Art/UI/ui_icon_like.png);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-gray);
    margin-right: 10px;
}

.catalog-like-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

/* ==========================================================================
   DETAIL OVERLAY VIEW (IMAGEN 1 DE FIGMA)
   ========================================================================== */
.detail-view {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    background-color: var(--dark-bg);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-top: 140px;
    padding-left: 44px;
    padding-right: 44px;
    padding-bottom: 0px;
}

.detail-view-hidden {
    display: none;
}

/* Detail Header */
.detail-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 120px;
    margin-bottom: 28px;
}

.detail-profile-info {
    flex-direction: row;
    align-items: center;
}

.detail-avatar-circle {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.30);
    align-items: center;
    justify-content: center;
    margin-right: 22px;
}

.detail-avatar-text {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--text-white);
}

.detail-username {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.detail-card-count {
    font-size: 28px;
    color: var(--text-gray);
}

.detail-close-btn {
    width: 72px;
    height: 72px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.detail-close-icon {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_close.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.85);
}

/* Detail Scroll View */
.detail-scroll {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

/* Detail 6-Cards Grid */
.detail-cards-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding-bottom: 380px;
    width: 100%;
}

.showcase-card {
    width: 48.2%;
    height: 640px;
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 2px;
    padding-top: 36px;
    padding-bottom: 30px;
    padding-left: 20px;
    padding-right: 20px;
    position: relative;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.showcase-card-star {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_star.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
}

.showcase-initials {
    font-size: 84px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    margin-top: 20px;
    margin-bottom: 16px;
}

.showcase-rarity {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.showcase-name {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--text-white);
    -unity-text-align: middle-center;
}

/* Floating Like Pill */
.floating-like-pill {
    position: absolute;
    right: 44px;
    bottom: 260px;
    height: 84px;
    border-radius: 42px;
    background-color: rgba(9, 19, 13, 0.95);
    border-width: 2px;
    border-color: var(--gold);
    flex-direction: row;
    align-items: center;
    padding-left: 30px;
    padding-right: 32px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.floating-like-pill:active {
    scale: 0.94;
}

.floating-like-icon {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_like.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
    margin-right: 12px;
}

.floating-like-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--gold);
}

/* ==========================================================================
   INTEGRATED MOBILE SCROLLBAR (Figma Sleek Style)
   ========================================================================== */
.detail-scroll .unity-scroller--vertical,
.catalog-scroll .unity-scroller--vertical,
.unity-scroller--vertical {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 4px;
    top: 10px;
    bottom: 220px;
}

/* Ocultar las flechas cuadradas de escritorio (#unity-low-button, #unity-high-button) */
.unity-scroller__low-button,
.unity-scroller__high-button,
.detail-scroll #unity-low-button,
.detail-scroll #unity-high-button,
.catalog-scroll #unity-low-button,
.catalog-scroll #unity-high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Slider contenedor */
.detail-scroll .unity-slider,
.catalog-scroll .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

/* Pista translúcida sutil */
.detail-scroll #unity-tracker,
.catalog-scroll #unity-tracker,
.unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

/* Cápsula dorada deslizante estilizada */
.detail-scroll #unity-dragger,
.catalog-scroll #unity-dragger,
.unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 100px;
    margin: 0;
    opacity: 0.75;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.detail-scroll #unity-dragger:hover,
.detail-scroll #unity-dragger:active {
    background-color: #ffd257;
    opacity: 1;
}

/* ==========================================================================
   BOTTOM NAVIGATION BAR (LIQUID GLASS)
   ========================================================================== */
.bottom-nav-bar {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 48px;
    height: 140px;
    border-radius: 70px;
    background-color: rgba(14, 32, 22, 0.88);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
}

.nav-tab {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 160px;
    height: 100px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.nav-tab-active {
    background-color: rgba(232, 168, 32, 0.14);
    border-radius: 36px;
}

.nav-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
    margin-bottom: 6px;
}

.nav-icon-active {
    -unity-background-image-tint-color: var(--gold);
}

.nav-label {
    font-size: 18px;
    color: var(--text-dim);
}

.nav-label-active {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--gold);
}

/* ==========================================================================
   TU VITRINA BANNER & CARD
   ========================================================================== */
.my-vitrine-banner {
    width: 100%;
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 1.5px;
    border-color: rgba(232, 168, 32, 0.5);
    padding: 24px 26px;
    margin-bottom: 28px;
}

.my-vitrine-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.my-vitrine-title-group {
    flex-direction: row;
    align-items: center;
}

.my-vitrine-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 2px;
}

.my-vitrine-actions {
    flex-direction: row;
    align-items: center;
}

.btn-edit-vitrine {
    height: 56px;
    background-color: var(--gold);
    border-radius: 28px;
    border-width: 0;
    color: #0d1a13;
    font-size: 22px;
    -unity-font-style: bold;
    padding-left: 26px;
    padding-right: 26px;
    -unity-text-align: middle-center;
}

.btn-edit-vitrine:active {
    scale: 0.96;
}

/* ==========================================================================
   EDIT VITRINE MODAL
   ========================================================================== */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.modal-hidden {
    display: none;
}

.edit-vitrine-box {
    width: 100%;
    max-height: 85%;
    background-color: #0e2016;
    border-radius: 32px;
    border-width: 2px;
    border-color: var(--gold);
    padding: 36px 30px;
    justify-content: space-between;
}

.edit-vitrine-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.edit-vitrine-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 2px;
}

.edit-vitrine-subtitle {
    font-size: 24px;
    color: var(--text-gray);
    margin-bottom: 16px;
}

.edit-vitrine-count-pill {
    align-self: flex-start;
    background-color: rgba(232, 168, 32, 0.15);
    border-radius: 16px;
    padding: 6px 18px;
    color: var(--gold);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.edit-cards-scroll {
    max-height: 800px;
    margin-bottom: 24px;
}

.edit-cards-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.pick-card-item {
    width: 31%;
    height: 220px;
    background-color: var(--card-bg);
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    padding: 10px;
    margin-bottom: 16px;
}

.pick-card-item:active {
    scale: 0.96;
}

.pick-card-selected {
    border-color: var(--gold);
    background-color: rgba(232, 168, 32, 0.22);
}

.pick-card-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: var(--gold);
    color: #0d1a13;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.edit-actions-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.btn-cancel-edit {
    width: 45%;
    height: 80px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 40px;
    border-width: 1px;
    border-color: var(--border-subtle);
    color: var(--text-white);
    font-size: 24px;
    -unity-font-style: bold;
}

.btn-save-vitrine {
    width: 52%;
    height: 80px;
    background-color: var(--gold);
    border-radius: 40px;
    border-width: 0;
    color: #0d1a13;
    font-size: 24px;
    -unity-font-style: bold;
}
