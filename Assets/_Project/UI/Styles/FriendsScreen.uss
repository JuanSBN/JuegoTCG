/* ==========================================================================
   FRIENDS SCREEN - DESIGN TOKENS & FIGMA FIDELITY (1080x2400)
   Figma Source: docs/Pantallas 2.2/src/App.tsx lines 3019-3250
   Scale Factor: 2.75x (1080 / 393)
   ========================================================================== */

:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.70);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --text-dim: rgba(255, 255, 255, 0.40);
    --border-subtle: rgba(255, 255, 255, 0.12);
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 140px;
    padding-bottom: 0;
    position: relative;
    overflow: hidden;
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.friends-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
    flex-shrink: 0;
    height: 80px;
    width: 100%;
}

.back-btn {
    width: 64px;
    height: 64px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    padding: 0;
}

.back-btn:active {
    scale: 0.92;
}

.back-btn-icon {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.75);
}

.friends-title {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: var(--text-white);
}

/* ==========================================================================
   SCROLLBAR INTEGRADA (FIGMA GOLDEN PILL)
   ========================================================================== */
.friends-scroll-view {
    flex-grow: 1;
    margin-bottom: 0;
    width: 100%;
    position: relative;
}

.friends-scroll-view #unity-content-container,
.friends-scroll-content {
    padding-bottom: 380px;
    padding-right: 24px;
    width: 100%;
}

.friends-scroll-view .unity-scroller--vertical,
.friends-scroll-view #unity-vertical-scroller,
.friends-scroll-view .unity-scroller {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 2px;
    top: 10px;
    bottom: 240px;
}

.friends-scroll-view .unity-scroller--horizontal,
.friends-scroll-view #unity-horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.friends-scroll-view .unity-scroller__low-button,
.friends-scroll-view .unity-scroller__high-button,
.friends-scroll-view #unity-low-button,
.friends-scroll-view #unity-high-button,
.friends-scroll-view .unity-repeat-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.friends-scroll-view .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

.friends-scroll-view #unity-tracker,
.friends-scroll-view .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

.friends-scroll-view #unity-dragger,
.friends-scroll-view .unity-scroller--vertical .unity-base-slider__dragger,
.friends-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 120px;
    margin: 0;
    opacity: 0.65;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.friends-scroll-view #unity-dragger:hover,
.friends-scroll-view #unity-dragger:active {
    background-color: #FFD257;
    opacity: 1;
}

/* ==========================================================================
   CARD 1: TU CÓDIGO DE AMIGO Y BÚSQUEDA INTEGRADA
   ========================================================================== */
.friend-code-box {
    background-color: var(--card-bg);
    border-radius: 30px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 34px 34px;
    margin-bottom: 36px;
    width: 100%;
}

.code-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
    width: 100%;
}

.code-text-group {
    flex-direction: column;
}

.code-subtitle {
    font-size: 24px;
    color: var(--text-dim);
    margin-bottom: 6px;
}

.my-friend-code {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: var(--text-white);
}

.btn-copy {
    height: 68px;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: var(--border-subtle);
    flex-direction: row;
    align-items: center;
    padding-left: 24px;
    padding-right: 26px;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.btn-copy:active {
    scale: 0.95;
}

.copy-icon {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_copy.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.65);
    margin-right: 10px;
}

.copy-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-gray);
}

/* Barra de Búsqueda Integrada */
.search-input-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.search-box {
    flex: 1;
    height: 86px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    padding-right: 22px;
    margin-right: 16px;
}

.search-icon {
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_search.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.35);
    margin-right: 14px;
}

.search-input-field {
    flex: 1;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.search-input-field > .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-white);
    font-size: 28px;
    padding: 0;
    margin: 0;
}

.search-input-field > .unity-base-text-field__input--placeholder {
    color: var(--text-dim);
    font-size: 28px;
}

.btn-add-friend {
    height: 86px;
    padding-left: 34px;
    padding-right: 34px;
    min-width: 156px;
    border-radius: 22px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn-add-friend:active {
    scale: 0.96;
}

.btn-add-friend-text {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

/* ==========================================================================
   SECCIÓN: SOLICITUDES PENDIENTES
   ========================================================================== */
.section-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    width: 100%;
}

.section-title {
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--text-white);
    margin-right: 16px;
}

.requests-badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1.5px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.requests-badge-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-align: middle-center;
}

.request-card {
    background-color: var(--card-bg);
    border-radius: 26px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 0 28px;
    height: 124px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    width: 100%;
}

.avatar-circle {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    flex-shrink: 0;
}

.avatar-text {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

.request-user-name {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-white);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 16px;
}

.request-actions-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.btn-accept-request {
    height: 68px;
    min-width: 140px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 18px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn-accept-request:active {
    scale: 0.96;
}

.btn-accept-request-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #0D1A13;
}

.btn-reject-request {
    height: 68px;
    min-width: 140px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn-reject-request:active {
    scale: 0.96;
}

.btn-reject-request-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-gray);
}

/* ==========================================================================
   SECCIÓN: MIS AMIGOS
   ========================================================================== */
.friends-section {
    margin-top: 36px;
    margin-bottom: 40px;
    width: 100%;
}

.friend-card {
    background-color: var(--card-bg);
    border-radius: 30px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 34px 34px;
    margin-bottom: 28px;
    width: 100%;
}

.friend-top-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    width: 100%;
}

.friend-top-row .avatar-circle {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin-right: 20px;
}

.friend-top-row .avatar-text {
    font-size: 30px;
}

.friend-info-block {
    flex: 1;
}

.friend-name {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-white);
    margin-bottom: 4px;
}

.friend-level {
    font-size: 24px;
    color: var(--text-dim);
}

.friend-power-pill {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.lightning-icon {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_lightning.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
    margin-right: 10px;
}

.friend-power-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 1px;
}

/* Stats and Progress Bar */
.friend-stats-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 26px;
    width: 100%;
}

.stats-label {
    font-size: 26px;
    color: var(--text-dim);
}

.stats-dot {
    font-size: 24px;
    color: var(--text-dim);
    margin-left: 12px;
    margin-right: 12px;
}

.progress-track {
    flex: 1;
    height: 16px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.10);
    margin-left: 18px;
    margin-right: 18px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    border-radius: 8px;
    background-color: var(--gold);
}

.progress-pct {
    font-size: 26px;
    color: var(--text-gray);
    -unity-font-style: bold;
}

/* Friend Actions */
.friend-actions-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.btn-friend-action {
    flex: 1;
    height: 82px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-left: 6px;
    margin-right: 6px;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn-friend-action:active {
    scale: 0.96;
}

.btn-friend-action-text {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

/* ==========================================================================
   SECCIÓN: RANKING DE AMIGOS
   ========================================================================== */
.ranking-section {
    margin-top: 28px;
    width: 100%;
}

.ranking-title {
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--text-white);
    margin-top: 36px;
    margin-bottom: 26px;
}

.ranking-list {
    flex-direction: column;
    width: 100%;
}

.ranking-row {
    flex-direction: row;
    align-items: center;
    padding: 0 28px;
    height: 110px;
    background-color: var(--card-bg);
    border-radius: 24px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    margin-bottom: 18px;
    width: 100%;
}

.ranking-row-me {
    background-color: rgba(232, 168, 32, 0.08);
    border-color: var(--gold-border);
}

.ranking-pos {
    font-size: 32px;
    -unity-font-style: bold;
    width: 52px;
    color: var(--text-dim);
}

.ranking-pos-first {
    color: var(--gold);
}

.ranking-pos-second {
    color: rgba(220, 220, 220, 0.85);
}

.ranking-avatar {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.ranking-avatar-me {
    background-color: rgba(232, 168, 32, 0.15);
    border-color: var(--gold-border);
}

.ranking-avatar-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

.ranking-avatar-text-me {
    color: var(--gold);
}

.ranking-name {
    flex: 1;
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-gray);
    overflow: hidden;
    text-overflow: ellipsis;
}

.ranking-name-me {
    color: var(--text-white);
}

.ranking-power-box {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ranking-lightning {
    width: 28px;
    height: 28px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_lightning.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.35);
    margin-right: 8px;
}

.ranking-lightning-me {
    -unity-background-image-tint-color: var(--gold);
}

.ranking-power-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

.ranking-power-text-me {
    color: var(--gold);
}

/* ==========================================================================
   FEEDBACK / COMPARE MODAL
   ========================================================================== */
.modal-backdrop {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.modal-box {
    width: 100%;
    background-color: #0A1810;
    border-radius: 28px;
    border-width: 1.5px;
    border-color: var(--gold-border);
    padding: 44px 34px;
    align-items: center;
}

.modal-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 2px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.modal-desc {
    font-size: 26px;
    color: var(--text-white);
    margin-bottom: 32px;
    -unity-text-align: middle-center;
}

.modal-close-btn {
    width: 220px;
    height: 68px;
    border-radius: 16px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.modal-close-btn-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

.modal-hidden {
    display: none;
}

/* ==========================================================================
   LIQUID GLASS BOTTOM NAV
   ========================================================================== */
#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}
