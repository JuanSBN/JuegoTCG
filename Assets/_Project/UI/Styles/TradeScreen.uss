/* ==========================================================================
   TRADE SCREEN - UI TOOLKIT USS (1080x2400 Figma 1:1 Mobile Layout)
   Figma Fidelity: Docs/Pantallas 2.2 App.tsx lines 970-1080
   ========================================================================== */

:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.70);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --text-dim: rgba(255, 255, 255, 0.40);
    --border-subtle: rgba(255, 255, 255, 0.12);
    --rarity-mythic: #E8A820;
    --rarity-rare: #8B5CF6;
    --rarity-uncommon: #38BDF8;
    --rarity-common: #22C55E;
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 140px;
    padding-bottom: 0;
    position: relative;
    overflow: hidden;
}

/* ==========================================================================
   HEADER
   ========================================================================== */
.trade-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
    flex-shrink: 0;
    height: 80px;
    width: 100%;
}

.back-btn {
    width: 64px;
    height: 64px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    padding: 0;
}

.back-btn:active {
    scale: 0.92;
}

.back-btn-icon {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.85);
}

.trade-title {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: var(--text-white);
}

/* ==========================================================================
   TABS ROW (Pestañas 76px de alto táctiles)
   ========================================================================== */
.trade-tabs-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
    flex-shrink: 0;
    height: 84px;
    width: 100%;
}

.trade-tab-pill {
    height: 76px;
    border-radius: 38px;
    padding-left: 36px;
    padding-right: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    background-color: transparent;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.trade-tab-pill:active {
    scale: 0.95;
}

.trade-tab-pill-active {
    background-color: var(--gold);
    border-color: var(--gold);
}

.trade-tab-label {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

.trade-tab-pill-active .trade-tab-label {
    color: #0D1A13;
}

.trade-tab-badge {
    min-width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
    margin-left: 14px;
    padding-left: 8px;
    padding-right: 8px;
}

.trade-tab-pill-active .trade-tab-badge {
    background-color: #0D1A13;
    border-width: 0;
}

.trade-tab-badge-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-align: middle-center;
}

/* ==========================================================================
   SCROLL VIEW & CARDS LIST
   ========================================================================== */
.trade-scroll-view {
    flex-grow: 1;
    width: 100%;
    position: relative;
}

.trade-scroll-view #unity-content-container {
    padding-bottom: 380px;
    padding-right: 20px;
    width: 100%;
}

.trade-cards-list {
    flex-direction: column;
    width: 100%;
}

/* Individual Trade Card */
.trade-card {
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 30px;
    padding-right: 30px;
    margin-bottom: 28px;
    position: relative;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
    width: 100%;
}

.trade-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
}

.trade-card-unread {
    border-color: rgba(232, 168, 32, 0.50);
}

/* Card Header */
.trade-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
    width: 100%;
}

.trade-avatar-circle {
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 18px;
}

.trade-avatar-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-white);
}

.trade-user-name {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--text-white);
    flex-grow: 1;
}

.trade-time-label {
    font-size: 24px;
    color: var(--text-dim);
    margin-right: 14px;
}

.trade-unread-dot {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--gold);
}

/* Exchange Area */
.trade-exchange-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    background-color: rgba(0, 0, 0, 0.30);
    border-radius: 22px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
    width: 100%;
}

.trade-side-col {
    flex: 1;
    flex-direction: column;
}

.trade-side-col-right {
    align-items: flex-end;
}

.trade-side-title {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-dim);
    margin-bottom: 12px;
}

.trade-tokens-row {
    flex-direction: row;
    align-items: center;
}

.trade-token {
    width: 90px;
    height: 124px;
    border-radius: 14px;
    background-color: #090F0C;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    border-width: 2px;
}

.trade-token-mythic {
    border-color: var(--rarity-mythic);
}

.trade-token-rare {
    border-color: var(--rarity-rare);
}

.trade-token-uncommon {
    border-color: var(--rarity-uncommon);
}

.trade-token-common {
    border-color: var(--rarity-common);
}

.trade-token-text {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.trade-token-mythic .trade-token-text { color: var(--rarity-mythic); }
.trade-token-rare .trade-token-text { color: var(--rarity-rare); }
.trade-token-uncommon .trade-token-text { color: var(--rarity-uncommon); }
.trade-token-common .trade-token-text { color: var(--rarity-common); }

.trade-swap-icon {
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_swap.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.45);
    margin-left: 16px;
    margin-right: 16px;
}

/* Card Actions */
.trade-actions-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.trade-btn-accept {
    flex: 1;
    height: 80px;
    border-radius: 20px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    transition-property: scale;
    transition-duration: 0.12s;
}

.trade-btn-accept:active {
    scale: 0.96;
}

.trade-btn-accept-text {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

.trade-btn-reject {
    flex: 1;
    height: 80px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.trade-btn-reject:active {
    scale: 0.96;
}

.trade-btn-reject-text {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

.trade-btn-cancel {
    width: 100%;
    height: 80px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.16);
    align-items: center;
    justify-content: center;
}

.trade-btn-cancel-text {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

/* ==========================================================================
   FLOATING ACTION BUTTON (+ NUEVO INTERCAMBIO)
   ========================================================================== */
.trade-fab {
    position: absolute;
    bottom: 260px;
    right: 44px;
    height: 84px;
    border-radius: 42px;
    background-color: var(--gold);
    border-width: 0;
    padding-left: 36px;
    padding-right: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.15s;
    z-index: 50;
}

.trade-fab:hover {
    scale: 1.04;
}

.trade-fab:active {
    scale: 0.95;
}

.trade-fab-text {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

/* ==========================================================================
   EMPTY STATE
   ========================================================================== */
.trade-empty-state {
    align-items: center;
    justify-content: center;
    padding-top: 140px;
    padding-bottom: 80px;
    width: 100%;
}

.trade-empty-icon {
    width: 96px;
    height: 96px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_empty.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
    margin-bottom: 24px;
}

.trade-empty-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-white);
    margin-bottom: 12px;
}

.trade-empty-sub {
    font-size: 26px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    width: 580px;
}

/* ==========================================================================
   INTEGRATED MOBILE SCROLLBAR (Figma Sleek Golden Style)
   ========================================================================== */
.trade-scroll-view .unity-scroller--vertical,
.trade-scroll-view #unity-vertical-scroller,
.unity-scroller--vertical {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 0;
    top: 10px;
    bottom: 240px;
}

.trade-scroll-view .unity-scroller--horizontal,
.trade-scroll-view #unity-horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.trade-scroll-view .unity-scroller__low-button,
.trade-scroll-view .unity-scroller__high-button,
.trade-scroll-view #unity-low-button,
.trade-scroll-view #unity-high-button,
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.trade-scroll-view .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

.trade-scroll-view #unity-tracker,
.trade-scroll-view .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

.trade-scroll-view #unity-dragger,
.trade-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 120px;
    margin: 0;
    opacity: 0.65;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.trade-scroll-view #unity-dragger:hover,
.trade-scroll-view #unity-dragger:active {
    background-color: #FFD257;
    opacity: 1;
}

/* ==========================================================================
   LIQUID GLASS BOTTOM NAV
   ========================================================================== */
#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}