:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.70);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --text-dim: rgba(255, 255, 255, 0.40);
    --border-subtle: rgba(255, 255, 255, 0.12);
    --rarity-mythic: #E8A820;
    --rarity-rare: #8B5CF6;
    --rarity-uncommon: #38BDF8;
    --rarity-common: #22C55E;
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 56px;
    padding-bottom: 0;
    position: relative;
}

/* Header */
.trade-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.back-btn {
    width: 56px;
    height: 56px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    padding: 0;
}

.back-btn:active {
    scale: 0.92;
}

.back-btn-icon {
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.75);
}

.trade-title {
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: var(--text-white);
}

/* Tabs Row */
.trade-tabs-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.trade-tab-pill {
    height: 64px;
    border-radius: 32px;
    padding-left: 28px;
    padding-right: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    background-color: transparent;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.trade-tab-pill:active {
    scale: 0.95;
}

.trade-tab-pill-active {
    background-color: var(--gold);
    border-color: var(--gold);
}

.trade-tab-label {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

.trade-tab-pill-active .trade-tab-label {
    color: #0D1A13;
}

.trade-tab-badge {
    min-width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
    margin-left: 12px;
    padding-left: 6px;
    padding-right: 6px;
}

.trade-tab-pill-active .trade-tab-badge {
    background-color: #0D1A13;
    border-width: 0;
}

.trade-tab-badge-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-align: middle-center;
}

/* Scroll View & Cards List */
.trade-scroll-view {
    flex: 1;
    margin-bottom: 0;
}

.trade-cards-list {
    flex-direction: column;
    padding-bottom: 230px;
}

/* Individual Trade Card */
.trade-card {
    background-color: var(--card-bg);
    border-radius: 24px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 24px 28px;
    margin-bottom: 24px;
    position: relative;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.trade-card:hover {
    border-color: rgba(255, 255, 255, 0.22);
}

.trade-card-unread {
    border-color: rgba(232, 168, 32, 0.45);
}

/* Card Header */
.trade-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.trade-avatar-circle {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
}

.trade-avatar-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

.trade-user-name {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--text-white);
    flex-grow: 1;
}

.trade-time-label {
    font-size: 22px;
    color: var(--text-dim);
    margin-right: 12px;
}

.trade-unread-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--gold);
}

/* Exchange Area */
.trade-exchange-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 18px;
    padding: 16px 20px;
}

.trade-side-col {
    flex: 1;
    flex-direction: column;
}

.trade-side-col-right {
    align-items: flex-end;
}

.trade-side-title {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: var(--text-dim);
    margin-bottom: 8px;
}

.trade-tokens-row {
    flex-direction: row;
    align-items: center;
}

.trade-token {
    width: 68px;
    height: 90px;
    border-radius: 12px;
    background-color: #090F0C;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    border-width: 2px;
}

.trade-tokens-row .trade-token {
    margin-right: 0;
}

.trade-token-mythic {
    border-color: var(--rarity-mythic);
}

.trade-token-rare {
    border-color: var(--rarity-rare);
}

.trade-token-uncommon {
    border-color: var(--rarity-uncommon);
}

.trade-token-common {
    border-color: var(--rarity-common);
}

.trade-token-text {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.trade-token-mythic .trade-token-text { color: var(--rarity-mythic); }
.trade-token-rare .trade-token-text { color: var(--rarity-rare); }
.trade-token-uncommon .trade-token-text { color: var(--rarity-uncommon); }
.trade-token-common .trade-token-text { color: var(--rarity-common); }

.trade-swap-icon {
    width: 44px;
    height: 44px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_swap.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.35);
    margin-left: 12px;
    margin-right: 12px;
}

/* Card Actions */
.trade-actions-row {
    flex-direction: row;
    justify-content: space-between;
}

.trade-btn-accept {
    flex: 1;
    height: 68px;
    border-radius: 16px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.trade-btn-accept:active {
    scale: 0.96;
}

.trade-btn-accept-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

.trade-btn-reject {
    flex: 1;
    height: 68px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
}

.trade-btn-reject:active {
    scale: 0.96;
}

.trade-btn-reject-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

.trade-btn-cancel {
    width: 100%;
    height: 68px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.16);
    align-items: center;
    justify-content: center;
}

.trade-btn-cancel-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--text-gray);
}

/* Floating Action Button (FAB) */
.trade-fab {
    position: absolute;
    bottom: 195px;
    right: 40px;
    height: 74px;
    border-radius: 37px;
    background-color: var(--gold);
    border-width: 0;
    padding-left: 32px;
    padding-right: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.15s;
}

.trade-fab:hover {
    scale: 1.04;
}

.trade-fab:active {
    scale: 0.95;
}

.trade-fab-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

/* Empty State */
.trade-empty-state {
    align-items: center;
    justify-content: center;
    padding-top: 120px;
    padding-bottom: 80px;
}

.trade-empty-icon {
    width: 80px;
    height: 80px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_swap.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.15);
    margin-bottom: 24px;
}

.trade-empty-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.40);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.trade-empty-desc {
    font-size: 22px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    padding-left: 60px;
    padding-right: 60px;
}

#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}