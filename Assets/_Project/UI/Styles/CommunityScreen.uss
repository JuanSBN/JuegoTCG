:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.70);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --border-subtle: rgba(255, 255, 255, 0.12);
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 56px;
    padding-bottom: 0;
    position: relative;
}

/* Header */
.community-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 40px;
    flex-shrink: 0;
}

.community-title {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: var(--text-white);
}

/* 2x2 Grid */
.community-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.community-card {
    width: 48.5%;
    height: 380px;
    background-color: var(--card-bg);
    border-radius: 24px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    padding: 24px;
    margin-bottom: 24px;
    position: relative;
    transition-property: scale;
    transition-duration: 0.15s;
}

.community-card:hover {
    scale: 1.03;
    border-color: rgba(255, 255, 255, 0.25);
}

.community-card-badge {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--gold);
    background-color: rgba(6, 17, 11, 0.95);
    align-items: center;
    justify-content: center;
}

.community-badge-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-align: middle-center;
}

.community-card-icon {
    width: 72px;
    height: 72px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 24px;
}

.community-card-label {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text-gray);
    -unity-text-align: middle-center;
}

#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}