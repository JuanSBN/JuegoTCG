/* ==========================================================================
   PROFILE SCREEN - DESIGN TOKENS & FIGMA FIDELITY (1080x2400)
   Figma Source: docs/Pantallas 2.2/src/App.tsx lines 3675-3915
   Scale Factor: 2.75x (1080 / 393)
   ========================================================================== */

:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.70);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --text-dim: rgba(255, 255, 255, 0.40);
    --border-subtle: rgba(255, 255, 255, 0.12);
    --rarity-mythic: #E8A820;
    --rarity-rare: #8B5CF6;
    --rarity-uncommon: #38BDF8;
    --rarity-common: #22C55E;
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 130px;
    padding-bottom: 0;
    position: relative;
    overflow: hidden;
}

/* ─────────────────────────────────────────────────────────── */
/* SCROLLBAR INTEGRADA (FIGMA GOLDEN PILL)                     */
/* ─────────────────────────────────────────────────────────── */
.profile-scroll-view {
    flex-grow: 1;
    margin-bottom: 0;
    width: 100%;
    position: relative;
}

.profile-scroll-view #unity-content-container,
.profile-scroll-content {
    padding-bottom: 380px;
    padding-right: 24px;
    width: 100%;
}

.profile-scroll-view .unity-scroller--vertical,
.profile-scroll-view #unity-vertical-scroller,
.profile-scroll-view .unity-scroller {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 2px;
    top: 10px;
    bottom: 240px;
}

.profile-scroll-view .unity-scroller--horizontal,
.profile-scroll-view #unity-horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.profile-scroll-view .unity-scroller__low-button,
.profile-scroll-view .unity-scroller__high-button,
.profile-scroll-view #unity-low-button,
.profile-scroll-view #unity-high-button,
.profile-scroll-view .unity-repeat-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.profile-scroll-view .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

.profile-scroll-view #unity-tracker,
.profile-scroll-view .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

.profile-scroll-view #unity-dragger,
.profile-scroll-view .unity-scroller--vertical .unity-base-slider__dragger,
.profile-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 120px;
    margin: 0;
    opacity: 0.65;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.profile-scroll-view #unity-dragger:hover,
.profile-scroll-view #unity-dragger:active {
    background-color: #FFD257;
    opacity: 1;
}

/* ─────────────────────────────────────────────────────────── */
/* HEADER: AVATAR, NAME, FRIEND CODE & SETTINGS                */
/* ─────────────────────────────────────────────────────────── */
.profile-header {
    align-items: center;
    position: relative;
    padding-top: 10px;
    padding-bottom: 32px;
    width: 100%;
}

.settings-btn {
    position: absolute;
    top: 10px;
    right: 4px;
    width: 68px;
    height: 68px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.settings-btn:active {
    scale: 0.92;
}

.settings-icon {
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_gear.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.45);
}

.avatar-wrapper {
    position: relative;
    margin-bottom: 22px;
}

.profile-avatar-circle {
    width: 210px;
    height: 210px;
    border-radius: 105px;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 3px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.profile-avatar-icon {
    width: 96px;
    height: 96px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_user.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.45);
}

.avatar-edit-badge {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: #06110B;
    border-width: 2.5px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
    padding: 0;
}

.avatar-edit-badge:active {
    scale: 0.92;
}

.avatar-edit-icon {
    width: 28px;
    height: 28px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_edit.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
}

.username-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.profile-username {
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--text-white);
    margin-right: 14px;
}

.btn-edit-username {
    width: 44px;
    height: 44px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.btn-edit-username:active {
    scale: 0.90;
}

.edit-icon-small {
    width: 30px;
    height: 30px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_edit.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.35);
}

.friend-code-pill-btn {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    padding: 6px 14px;
}

.friend-code-pill-btn:active {
    scale: 0.96;
}

.code-pill-label {
    font-size: 30px;
    color: var(--text-gray);
    letter-spacing: 1px;
}

.code-pill-number {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    margin-left: 8px;
    margin-right: 12px;
}

.code-copy-icon {
    width: 28px;
    height: 28px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_copy.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.40);
}

/* ─────────────────────────────────────────────────────────── */
/* SECCIÓN: MI 11 IDEAL (CANCHA TÁCTICA)                       */
/* ─────────────────────────────────────────────────────────── */
.formation-section {
    margin-top: 12px;
    margin-bottom: 44px;
    width: 100%;
}

.section-header-between {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
}

.profile-section-title {
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--text-white);
}

.formation-slots-count {
    font-size: 28px;
    color: var(--text-gray);
    letter-spacing: 1px;
}

/* Tactical Pitch Box */
.tactical-pitch-box {
    width: 100%;
    height: 940px;
    background-color: #08150D;
    border-radius: 28px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    position: relative;
    overflow: hidden;
}

/* Pitch Field Lines */
.pitch-boundary-line {
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 18px;
    right: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 14px;
}

.pitch-halfway-line {
    position: absolute;
    top: 50%;
    left: 18px;
    right: 18px;
    height: 1.5px;
    background-color: rgba(255, 255, 255, 0.14);
}

.pitch-center-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 250px;
    height: 250px;
    margin-top: -125px;
    margin-left: -125px;
    border-radius: 125px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    align-items: center;
    justify-content: center;
}

.pitch-center-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.25);
}

.pitch-penalty-top {
    position: absolute;
    top: 18px;
    left: 50%;
    width: 490px;
    height: 200px;
    margin-left: -245px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
}

.pitch-penalty-bottom {
    position: absolute;
    bottom: 18px;
    left: 50%;
    width: 490px;
    height: 200px;
    margin-left: -245px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
}

/* ─────────────────────────────────────────────────────────── */
/* PLAYER SLOTS ON PITCH                                       */
/* ─────────────────────────────────────────────────────────── */
.pitch-player-slot {
    position: absolute;
    width: 132px;
    height: 180px;
    margin-left: -66px;
    margin-top: -90px;
    background-color: var(--card-bg);
    border-radius: 18px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    opacity: 0.40;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.pitch-player-slot:active {
    scale: 0.94;
}

.slot-occupied {
    opacity: 1;
}

.slot-mythic {
    border-color: var(--rarity-mythic);
}

.slot-rare {
    border-color: var(--rarity-rare);
}

.slot-uncommon {
    border-color: var(--rarity-uncommon);
}

.slot-common {
    border-color: var(--rarity-common);
}

.slot-pos-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: rgba(6, 14, 10, 0.92);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 12px;
    padding: 4px 10px;
}

.slot-pos-badge-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text-dim);
    -unity-text-align: middle-center;
}

.slot-mythic .slot-pos-badge-text { color: var(--rarity-mythic); }
.slot-rare .slot-pos-badge-text { color: var(--rarity-rare); }
.slot-uncommon .slot-pos-badge-text { color: var(--rarity-uncommon); }
.slot-common .slot-pos-badge-text { color: var(--rarity-common); }

.slot-token-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    margin-top: 18px;
}

.slot-mythic .slot-token-circle { border-color: var(--rarity-mythic); }
.slot-rare .slot-token-circle { border-color: var(--rarity-rare); }
.slot-uncommon .slot-token-circle { border-color: var(--rarity-uncommon); }
.slot-common .slot-token-circle { border-color: var(--rarity-common); }

/* ─────────────────────────────────────────────────────────── */
/* SECCIÓN: CARTAS DESTACADAS                                  */
/* ─────────────────────────────────────────────────────────── */
.featured-section {
    margin-top: 8px;
    margin-bottom: 24px;
    width: 100%;
}

.featured-cards-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.featured-card {
    width: 31%;
    height: 410px;
    background-color: var(--card-bg);
    border-radius: 24px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 36px 14px 28px;
    align-items: center;
    justify-content: space-between;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.featured-card:active {
    scale: 0.95;
}

.featured-card-mythic {
    border-color: var(--rarity-mythic);
}

.featured-card-rare {
    border-color: var(--rarity-rare);
}

.featured-card-empty {
    opacity: 0.40;
    border-color: rgba(255, 255, 255, 0.15);
}

.featured-avatar-circle {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
}

.featured-card-mythic .featured-avatar-circle { border-color: var(--rarity-mythic); }
.featured-card-rare .featured-avatar-circle { border-color: var(--rarity-rare); }

.featured-avatar-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

.featured-card-mythic .featured-avatar-text { color: var(--rarity-mythic); }
.featured-card-rare .featured-avatar-text { color: var(--rarity-rare); }

.featured-card-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-gray);
    -unity-text-align: middle-center;
}

.featured-card-empty .featured-card-name {
    color: var(--text-dim);
    -unity-font-style: normal;
}

/* ─────────────────────────────────────────────────────────── */
/* MODALES DE FEEDBACK                                         */
/* ─────────────────────────────────────────────────────────── */
.modal-backdrop {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
    padding: 44px;
}

.modal-box {
    width: 100%;
    background-color: #0A1810;
    border-radius: 30px;
    border-width: 1.5px;
    border-color: var(--gold-border);
    padding: 48px 36px;
    align-items: center;
}

.modal-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 2px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.modal-desc {
    font-size: 28px;
    color: var(--text-white);
    margin-bottom: 32px;
    -unity-text-align: middle-center;
}

.modal-close-btn {
    width: 240px;
    height: 72px;
    border-radius: 18px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.modal-close-btn-text {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

.modal-hidden {
    display: none;
}

/* ─────────────────────────────────────────────────────────── */
/* LIQUID GLASS BOTTOM NAV                                    */
/* ─────────────────────────────────────────────────────────── */
#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}
