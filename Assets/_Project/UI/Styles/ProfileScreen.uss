:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.70);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --text-dim: rgba(255, 255, 255, 0.40);
    --border-subtle: rgba(255, 255, 255, 0.12);
    --rarity-mythic: #E8A820;
    --rarity-rare: #8B5CF6;
    --rarity-uncommon: #38BDF8;
    --rarity-common: #22C55E;
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 56px;
    padding-bottom: 0;
    position: relative;
}

/* ─────────────────────────────────────────────────────────── */
/* SCROLLBAR INTEGRADA (FIGMA GOLDEN PILL)                     */
/* ─────────────────────────────────────────────────────────── */
.profile-scroll-view {
    flex: 1;
    margin-bottom: 0;
    width: 100%;
}

.profile-scroll-view .unity-scroller--vertical {
    width: 8px;
    margin-right: -28px;
}

.profile-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.profile-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    background-color: rgba(232, 168, 32, 0.55);
    border-radius: 4px;
    border-width: 0;
    left: 0;
}

.profile-scroll-view .unity-scroller--vertical .unity-scroller__low-button,
.profile-scroll-view .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
    opacity: 0;
    width: 0;
    height: 0;
}

/* Safe Area Bottom Padding for Floating Nav Bar */
.profile-scroll-content {
    padding-bottom: 340px;
    width: 100%;
}

/* ─────────────────────────────────────────────────────────── */
/* HEADER: AVATAR, NAME, FRIEND CODE & SETTINGS                */
/* ─────────────────────────────────────────────────────────── */
.profile-header {
    align-items: center;
    position: relative;
    padding-top: 10px;
    padding-bottom: 28px;
    width: 100%;
}

.settings-btn {
    position: absolute;
    top: 6px;
    right: 0;
    width: 56px;
    height: 56px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.settings-btn:active {
    scale: 0.92;
}

.settings-icon {
    width: 38px;
    height: 38px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_gear.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.45);
}

.avatar-wrapper {
    position: relative;
    margin-bottom: 18px;
}

.profile-avatar-circle {
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2.5px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
}

.profile-avatar-icon {
    width: 68px;
    height: 68px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_user.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.45);
}

.avatar-edit-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background-color: #06110B;
    border-width: 2px;
    border-color: var(--gold-border);
    align-items: center;
    justify-content: center;
    padding: 0;
}

.avatar-edit-badge:active {
    scale: 0.92;
}

.avatar-edit-icon {
    width: 20px;
    height: 20px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_edit.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
}

.username-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.profile-username {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--text-white);
    margin-right: 12px;
}

.btn-edit-username {
    width: 36px;
    height: 36px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.btn-edit-username:active {
    scale: 0.90;
}

.edit-icon-small {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_edit.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.35);
}

.friend-code-pill-btn {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    padding: 4px 10px;
}

.friend-code-pill-btn:active {
    scale: 0.96;
}

.code-pill-label {
    font-size: 24px;
    color: var(--text-gray);
    letter-spacing: 1px;
}

.code-pill-number {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    margin-left: 6px;
    margin-right: 10px;
}

.code-copy-icon {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_copy.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.40);
}

/* ─────────────────────────────────────────────────────────── */
/* SECCIÓN: MI 11 IDEAL (CANCHA TÁCTICA)                       */
/* ─────────────────────────────────────────────────────────── */
.formation-section {
    margin-bottom: 40px;
    width: 100%;
}

.section-header-between {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.profile-section-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--text-white);
}

.formation-slots-count {
    font-size: 22px;
    color: var(--text-gray);
    letter-spacing: 1px;
}

/* Tactical Pitch Box */
.tactical-pitch-box {
    width: 100%;
    height: 880px;
    background-color: rgba(8, 18, 12, 0.80);
    border-radius: 26px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    position: relative;
    overflow: hidden;
}

/* Pitch Field Lines SVG/Vector Simulation */
.pitch-boundary-line {
    position: absolute;
    top: 16px;
    bottom: 16px;
    left: 16px;
    right: 16px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

.pitch-halfway-line {
    position: absolute;
    top: 50%;
    left: 16px;
    right: 16px;
    height: 1.5px;
    background-color: rgba(255, 255, 255, 0.08);
}

.pitch-center-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 180px;
    height: 180px;
    margin-top: -90px;
    margin-left: -90px;
    border-radius: 90px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.08);
    align-items: center;
    justify-content: center;
}

.pitch-center-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.15);
}

.pitch-penalty-top {
    position: absolute;
    top: 16px;
    left: 50%;
    width: 380px;
    height: 150px;
    margin-left: -190px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.08);
}

.pitch-penalty-bottom {
    position: absolute;
    bottom: 16px;
    left: 50%;
    width: 380px;
    height: 150px;
    margin-left: -190px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.08);
}

/* ─────────────────────────────────────────────────────────── */
/* PLAYER SLOTS ON PITCH                                       */
/* ─────────────────────────────────────────────────────────── */
.pitch-player-slot {
    position: absolute;
    width: 104px;
    height: 144px;
    margin-left: -52px;
    margin-top: -72px;
    background-color: var(--card-bg);
    border-radius: 16px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
    opacity: 0.40;
    transition-property: scale;
    transition-duration: 0.15s;
}

.pitch-player-slot:active {
    scale: 0.94;
}

.slot-occupied {
    opacity: 1;
}

.slot-mythic {
    border-color: var(--rarity-mythic);
}

.slot-rare {
    border-color: var(--rarity-rare);
}

.slot-uncommon {
    border-color: var(--rarity-uncommon);
}

.slot-common {
    border-color: var(--rarity-common);
}

.slot-pos-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    background-color: rgba(6, 14, 10, 0.90);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 6px;
    padding: 2px 6px;
}

.slot-pos-badge-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-dim);
}

.slot-mythic .slot-pos-badge-text { color: var(--rarity-mythic); }
.slot-rare .slot-pos-badge-text { color: var(--rarity-rare); }
.slot-uncommon .slot-pos-badge-text { color: var(--rarity-uncommon); }
.slot-common .slot-pos-badge-text { color: var(--rarity-common); }

.slot-token-circle {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    margin-top: 14px;
}

.slot-mythic .slot-token-circle { border-color: var(--rarity-mythic); }
.slot-rare .slot-token-circle { border-color: var(--rarity-rare); }
.slot-uncommon .slot-token-circle { border-color: var(--rarity-uncommon); }
.slot-common .slot-token-circle { border-color: var(--rarity-common); }

/* ─────────────────────────────────────────────────────────── */
/* SECCIÓN: CARTAS DESTACADAS                                  */
/* ─────────────────────────────────────────────────────────── */
.featured-section {
    margin-bottom: 20px;
    width: 100%;
}

.featured-cards-row {
    flex-direction: row;
    justify-content: space-between;
}

.featured-card {
    width: 31%;
    aspect-ratio: 0.72;
    background-color: var(--card-bg);
    border-radius: 18px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    padding: 24px 12px 18px;
    align-items: center;
    justify-content: space-between;
    transition-property: scale;
    transition-duration: 0.15s;
}

.featured-card:active {
    scale: 0.95;
}

.featured-card-mythic {
    border-color: var(--rarity-mythic);
}

.featured-card-rare {
    border-color: var(--rarity-rare);
}

.featured-card-empty {
    opacity: 0.40;
}

.featured-avatar-circle {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: center;
}

.featured-card-mythic .featured-avatar-circle { border-color: var(--rarity-mythic); }
.featured-card-rare .featured-avatar-circle { border-color: var(--rarity-rare); }

.featured-avatar-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-gray);
}

.featured-card-mythic .featured-avatar-text { color: var(--rarity-mythic); }
.featured-card-rare .featured-avatar-text { color: var(--rarity-rare); }

.featured-card-name {
    font-size: 22px;
    color: var(--text-gray);
    -unity-text-align: middle-center;
}

.featured-card-empty .featured-card-name {
    color: var(--text-dim);
}

/* Modals */
.modal-backdrop {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.modal-box {
    width: 100%;
    background-color: #0A1810;
    border-radius: 28px;
    border-width: 1.5px;
    border-color: var(--gold-border);
    padding: 40px 32px;
    align-items: center;
}

.modal-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--gold);
    letter-spacing: 2px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.modal-desc {
    font-size: 24px;
    color: var(--text-white);
    margin-bottom: 28px;
    -unity-text-align: middle-center;
}

.modal-close-btn {
    width: 200px;
    height: 64px;
    border-radius: 16px;
    background-color: var(--gold);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.modal-close-btn-text {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #0D1A13;
}

.modal-hidden {
    display: none;
}

#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}