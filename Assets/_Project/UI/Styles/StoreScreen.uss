/* ==========================================================================
   STORE SCREEN - UI TOOLKIT USS (1080x2400 Figma 1:1 Mobile Layout)
   Figma Fidelity: Docs/Pantallas 2.2 App.tsx lines 590-730
   ========================================================================== */

:root {
    --bg-dark: #06110B;
    --card-bg: rgba(13, 26, 19, 0.85);
    --gold: #E8A820;
    --gold-border: rgba(232, 168, 32, 0.65);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --text-white: #F5F5F7;
    --text-gray: rgba(255, 255, 255, 0.65);
    --text-dim: rgba(255, 255, 255, 0.40);
    --border-subtle: rgba(255, 255, 255, 0.12);
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 140px;
    padding-bottom: 0;
    position: relative;
    overflow: hidden;
}

#BottomNavBar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 0;
}

/* ==========================================================================
   HEADER: TIENDA + COIN CHIP
   ========================================================================== */
.store-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-shrink: 0;
    width: 100%;
}

.store-title {
    font-size: 60px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: var(--text-white);
}

.currency-pill,
.coin-chip {
    flex-direction: row;
    align-items: center;
    height: 84px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1.5px;
    border-color: var(--gold-border);
    border-radius: 42px;
    padding-left: 22px;
    padding-right: 26px;
}

.coin-icon {
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_coin.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 10px;
}

.coins-text,
.coin-chip-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 1px;
}

/* ==========================================================================
   SCROLL VIEW
   ========================================================================== */
.store-scroll-view {
    flex-grow: 1;
    width: 100%;
    position: relative;
}

.store-scroll-view #unity-content-container {
    padding-bottom: 260px;
    padding-right: 22px;
    width: 100%;
}

/* Section Headings */
.section-heading {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: var(--text-white);
    margin-top: 36px;
    margin-bottom: 24px;
}

/* ==========================================================================
   SECCIÓN 1: COMPRAR SOBRES (3 Envelopes: Bronce, Oro, Diamante)
   ========================================================================== */
.sobres-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    width: 100%;
}

.envelope-column {
    width: 31.5%;
    align-items: stretch;
}

.envelope-column-featured {
    width: 33%;
}

.envelope-card {
    width: 100%;
    height: 570px;
    border-radius: 26px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    background-color: var(--card-bg);
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 30px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 0;
    transition-property: scale;
    transition-duration: 0.15s;
}

.envelope-card:hover {
    scale: 1.03;
}

.envelope-card:active {
    scale: 0.96;
}

.envelope-featured {
    height: 620px;
    border-color: var(--gold);
    border-width: 3.5px;
    background-color: rgba(13, 26, 19, 0.95);
    padding-bottom: 34px;
}

.envelope-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.envelope-label-featured {
    font-size: 30px;
    color: var(--gold);
    letter-spacing: 2.5px;
}

.envelope-buy-button {
    width: 100%;
    height: 86px;
    margin-top: 16px;
    border-radius: 20px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    background-color: rgba(255, 255, 255, 0.05);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.15s;
}

.envelope-buy-button:hover {
    scale: 1.04;
}

.envelope-buy-button:active {
    scale: 0.95;
}

.envelope-buy-button-featured {
    height: 90px;
    border-width: 2px;
    border-color: rgba(232, 168, 32, 0.85);
    background-color: rgba(232, 168, 32, 0.15);
}

.coin-icon-mini {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_coin.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 12px;
}

.envelope-price-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--text-white);
}

.envelope-price-text-featured {
    font-size: 34px;
    color: var(--gold);
}

/* ==========================================================================
   SECCIÓN 2: VER ANUNCIO (Banner de Recompensa de 190px)
   ========================================================================== */
.ad-banner {
    width: 100%;
    height: 190px;
    border-radius: 30px;
    border-width: 2px;
    border-color: var(--gold);
    background-color: rgba(14, 22, 10, 0.92);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 28px;
    padding-right: 32px;
    margin-bottom: 24px;
    transition-property: scale;
    transition-duration: 0.15s;
}

.ad-banner:hover {
    scale: 1.02;
}

.ad-banner:active {
    scale: 0.97;
}

.ad-play-circle {
    width: 96px;
    height: 96px;
    min-width: 96px;
    min-height: 96px;
    max-width: 96px;
    max-height: 96px;
    border-radius: 48px;
    background-color: var(--gold);
    align-items: center;
    justify-content: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.ad-play-icon {
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_play.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #07120B;
    margin-left: 4px;
}

.ad-info-container {
    flex-grow: 1;
    justify-content: center;
}

.ad-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--text-white);
    margin-bottom: 8px;
}

.ad-subtitle {
    font-size: 24px;
    color: var(--text-gray);
}

.ad-counter-container {
    align-items: center;
    justify-content: center;
    margin-left: 20px;
    flex-shrink: 0;
}

.ad-counter-number {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--gold);
    -unity-text-align: middle-center;
}

.ad-counter-label {
    font-size: 20px;
    color: var(--text-dim);
    letter-spacing: 3px;
    margin-top: 2px;
    -unity-text-align: middle-center;
}

/* ==========================================================================
   SECCIÓN 3: COMPRAR MONEDAS (Cuadrícula 2x2 - Tarjetas de 340px)
   ========================================================================== */
.coin-packs-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.coin-pack-card {
    width: 48.5%;
    height: 340px;
    background-color: var(--card-bg);
    border-radius: 28px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    align-items: center;
    justify-content: space-between;
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 18px;
    padding-right: 18px;
    margin-bottom: 24px;
    transition-property: scale;
    transition-duration: 0.15s;
}

.coin-pack-card:hover {
    scale: 1.03;
}

.coin-pack-card:active {
    scale: 0.96;
}

.coin-pack-art {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 64px;
    margin-top: 6px;
}

.coin-pack-icon-large {
    width: 58px;
    height: 58px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.coin-pack-icon-medium {
    width: 44px;
    height: 44px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_coin.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-left: 8px;
}

.coin-pack-coins {
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--text-white);
}

.coin-pack-bonus {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--gold);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.coin-pack-price-tag {
    border-radius: 16px;
    border-width: 1.5px;
    border-color: var(--border-subtle);
    background-color: rgba(255, 255, 255, 0.06);
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text-gray);
    letter-spacing: 1px;
}

/* ==========================================================================
   INTEGRATED MOBILE SCROLLBAR (Figma Sleek Golden Style)
   ========================================================================== */
.store-scroll-view .unity-scroller--vertical,
.store-scroll-view #unity-vertical-scroller,
.unity-scroller--vertical {
    width: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    position: absolute;
    right: 0;
    top: 10px;
    bottom: 240px;
}

/* Ocultar scrollbar horizontal por completo */
.store-scroll-view .unity-scroller--horizontal,
.store-scroll-view #unity-horizontal-scroller {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Ocultar botones de flecha toscos */
.store-scroll-view .unity-scroller__low-button,
.store-scroll-view .unity-scroller__high-button,
.store-scroll-view #unity-low-button,
.store-scroll-view #unity-high-button,
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Slider contenedor transparente */
.store-scroll-view .unity-slider {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    width: 6px;
}

/* Pista translúcida muy sutil */
.store-scroll-view #unity-tracker,
.store-scroll-view .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    margin: 0;
}

/* Cápsula dorada deslizante estilizada (Figma) */
.store-scroll-view #unity-dragger,
.store-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
    min-height: 120px;
    margin: 0;
    opacity: 0.65;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.store-scroll-view #unity-dragger:hover,
.store-scroll-view #unity-dragger:active {
    background-color: #FFD257;
    opacity: 1;
}

/* ==========================================================================
   FEEDBACK MODAL
   ========================================================================== */
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 10, 6, 0.85);
    align-items: center;
    justify-content: center;
    padding: 60px;
    z-index: 100;
}

.modal-hidden {
    display: none;
}

.feedback-card {
    width: 860px;
    background-color: #0c1c12;
    border-radius: 36px;
    border-width: 2px;
    border-color: var(--gold);
    padding: 48px;
    align-items: center;
}

.feedback-icon {
    width: 140px;
    height: 140px;
    margin-bottom: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.feedback-title {
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 2px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.feedback-message {
    font-size: 30px;
    color: var(--text-gray);
    -unity-text-align: middle-center;
    margin-bottom: 36px;
}

.feedback-close-btn {
    width: 100%;
    height: 94px;
    background-color: var(--gold);
    border-radius: 26px;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.feedback-close-btn:active {
    scale: 0.96;
}

.feedback-close-btn-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: #07120B;
    letter-spacing: 2px;
}