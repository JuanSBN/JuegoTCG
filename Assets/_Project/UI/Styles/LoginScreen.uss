/* ==========================================================================
   LOGIN SCREEN - DESIGN TOKENS & FIGMA FIDELITY (1080x2400)
   Inspirado en docs/Pantallas 2.2/src/App.tsx (Componente LoginScreen)
   Espaciado generoso, armónico y ergonómico para pantallas táctiles altas
   ========================================================================== */

:root {
    --gold: rgb(232, 168, 32);
    --gold-border: rgb(212, 150, 14);
    --gold-glow: rgba(232, 168, 32, 0.25);
    --card-bg: rgba(13, 26, 19, 0.85);
    --dark-bg: rgb(6, 17, 11);
    --border-subtle: rgba(255, 255, 255, 0.16);
    --text-white: rgb(245, 245, 247);
    --text-gray: rgba(255, 255, 255, 0.68);
    --text-dim: rgba(255, 255, 255, 0.42);
}

.screen-container {
    width: 100%;
    height: 100%;
    background-color: var(--dark-bg);
    background-image: url("project://database/Assets/_Project/Art/UI/bg_tactical_pitch.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
    padding-left: 72px;
    padding-right: 72px;
    padding-top: 100px;
    padding-bottom: 100px;
    position: relative;
    overflow: hidden;
}

/* ── Content Container (Centrado con distribución amplia) ── */
.login-content-box {
    width: 100%;
    max-width: 940px;
    align-items: center;
    justify-content: center;
}

/* ── 1. LogoMark TCG ── */
.login-logo-container {
    align-items: center;
    justify-content: center;
    margin-bottom: 72px;
}

.logo-cards-stacked {
    width: 280px;
    height: 250px;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
    position: relative;
}

.logo-card-back {
    position: absolute;
    width: 150px;
    height: 200px;
    background-color: rgba(232, 168, 32, 0.12);
    border-width: 2.5px;
    border-color: rgba(232, 168, 32, 0.35);
    border-radius: 24px;
    rotate: -10deg;
    left: 48px;
    top: 20px;
}

.logo-card-front {
    position: absolute;
    width: 150px;
    height: 200px;
    background-color: rgb(12, 24, 16);
    border-width: 3px;
    border-color: var(--gold);
    border-radius: 24px;
    align-items: center;
    justify-content: center;
    right: 48px;
    top: 26px;
}

.logo-card-ball-icon {
    width: 80px;
    height: 80px;
    background-image: url("project://database/Assets/_Project/Art/UI/ui_logo_cards.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--gold);
}

.logo-title-futcard {
    font-size: 72px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: var(--text-white);
    -unity-text-align: middle-center;
}

.logo-subtitle-tcg {
    font-size: 24px;
    letter-spacing: 6px;
    color: var(--text-dim);
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── 2. Encabezado Textual (Título + Subtítulo) ── */
.login-header-box {
    align-items: center;
    margin-bottom: 76px;
    padding-left: 24px;
    padding-right: 24px;
}

.login-title {
    font-size: 60px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: var(--text-white);
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.login-subtitle {
    font-size: 32px;
    color: var(--text-gray);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 820px;
    line-height: 46px;
}

/* ── 3. Botones de Proveedor (Google & Email) ── */
.providers-container {
    width: 100%;
    margin-bottom: 40px;
}

.provider-btn {
    width: 100%;
    height: 132px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 2px;
    border-color: var(--border-subtle);
    border-radius: 28px;
    flex-direction: row;
    align-items: center;
    padding-left: 48px;
    padding-right: 48px;
    margin-bottom: 24px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.provider-btn:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.32);
}

.provider-btn:active {
    scale: 0.98;
    background-color: rgba(232, 168, 32, 0.14);
    border-color: var(--gold);
}

.provider-icon {
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 32px;
}

.provider-icon-google {
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_google.png");
}

.provider-icon-email {
    background-image: url("project://database/Assets/_Project/Art/UI/ui_icon_email.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.88);
}

.provider-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-white);
    letter-spacing: 1px;
}

/* ── 4. Botón Invitado / Saltar ── */
.guest-btn {
    height: 76px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding-left: 36px;
    padding-right: 36px;
    margin-top: 10px;
    margin-bottom: 24px;
}

.guest-btn:active {
    scale: 0.96;
}

.guest-btn-text {
    font-size: 32px;
    color: var(--text-dim);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.guest-btn-text:hover {
    color: var(--text-gray);
}

/* ── 5. Términos y Condiciones ── */
.login-terms {
    font-size: 24px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin-top: 36px;
    line-height: 34px;
    max-width: 800px;
}
