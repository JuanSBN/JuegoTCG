                            <ui:Label text="Vacío" class="featured-card-name" style="display: none;" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:ScrollView>

        <!-- ── Sub-pantalla Modal: Selector de Jugador para 11 Ideal (Figma) ── -->
        <ui:VisualElement name="PitchCardSelectorModal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="pitch-modal-card">
                
                <!-- Header: Badge + Título + Cerrar ✕ -->
                <ui:VisualElement class="pitch-modal-header">
                    <ui:VisualElement class="pitch-modal-title-row">
                        <ui:VisualElement class="pitch-modal-badge">
                            <ui:Label name="PitchModalBadgeText" text="DEL" class="pitch-modal-badge-text" />
                        </ui:VisualElement>
                        <ui:Label name="PitchModalTitle" text="ELEGIR DELANTERO" class="pitch-modal-title" />
                    </ui:VisualElement>
                    <ui:Button name="Btn_ClosePitchModal" class="pitch-modal-close-btn">
                        <ui:Label text="✕" class="pitch-modal-close-icon" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Scrollable Cards Grid (2 Columnas) -->
                <ui:ScrollView name="PitchModalScrollView" class="pitch-modal-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="PitchModalCardsGrid" class="pitch-modal-grid">
                        <!-- Llenado dinámicamente con cartas poseídas que coincidan con la posición -->
                    </ui:VisualElement>
                    
                    <ui:VisualElement name="PitchModalEmptyState" class="pitch-modal-empty" style="display: none;">
                        <ui:Label text="No tienes cartas de esta posición en tu inventario." class="pitch-empty-title" />
                        <ui:Label text="Consigue nuevos jugadores abriendo sobres en la Tienda." class="pitch-empty-desc" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <!-- Botón de acción: Quitar del 11 Ideal -->
                <ui:Button name="Btn_RemoveFromPitch" class="btn-remove-from-pitch">
                    <ui:Label text="QUITAR DEL 11 IDEAL" class="btn-remove-from-pitch-text" />
                </ui:Button>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── Sub-pantalla Modal: Selector de Cartas Destacadas (Figma) ── -->
        <ui:VisualElement name="FeaturedCardSelectorModal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="pitch-modal-card">
                
                <!-- Header: Título + Cerrar ✕ -->
                <ui:VisualElement class="pitch-modal-header">
                    <ui:VisualElement class="pitch-modal-title-row">
                        <ui:Label text="ELEGIR CARTA DESTACADA" class="pitch-modal-title" />
                    </ui:VisualElement>
                    <ui:Button name="Btn_CloseFeaturedModal" class="pitch-modal-close-btn">
                        <ui:Label text="✕" class="pitch-modal-close-icon" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Filtros: Álbum | Recientes | Rareza | Cantidad -->
                <ui:VisualElement class="featured-filters-row">
                    <ui:Button name="Filter_Album" text="Álbum" class="featured-filter-pill filter-pill-active" />
                    <ui:Button name="Filter_Recientes" text="Recientes" class="featured-filter-pill" />
                    <ui:Button name="Filter_Rareza" text="Rareza" class="featured-filter-pill" />
                    <ui:Button name="Filter_Cantidad" text="Cantidad" class="featured-filter-pill" />
                </ui:VisualElement>

                <!-- Scrollable Cards Grid (2 Columnas) -->
                <ui:ScrollView name="FeaturedModalScrollView" class="pitch-modal-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="FeaturedModalCardsGrid" class="pitch-modal-grid">
                        <!-- Llenado dinámicamente con cartas poseídas -->
                    </ui:VisualElement>
                    
                    <ui:VisualElement name="FeaturedModalEmptyState" class="pitch-modal-empty" style="display: none;">
                        <ui:Label text="No tienes cartas en tu inventario." class="pitch-empty-title" />
                        <ui:Label text="Consigue nuevos jugadores abriendo sobres en la Tienda." class="pitch-empty-desc" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <!-- Botón de acción: Quitar de Destacadas -->
                <ui:Button name="Btn_RemoveFromFeatured" class="btn-remove-from-pitch">
                    <ui:Label text="QUITAR DE DESTACADAS" class="btn-remove-from-pitch-text" />
                </ui:Button>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Feedback / Customization Modal -->
        <ui:VisualElement name="ProfileFeedbackModal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="modal-box">
                <ui:Label name="ModalTitle" text="MI 11 IDEAL" class="modal-title" />
                <ui:Label name="ModalDesc" text="Has seleccionado esta posición táctica." class="modal-desc" />
                <ui:Button name="Btn_CloseModal" class="modal-close-btn">
                    <ui:Label text="ENTENDIDO" class="modal-close-btn-text" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Liquid Glass Bottom Nav -->
        <ui:Instance template="LiquidGlassNavBar" name="BottomNavBar" />

    </ui:VisualElement>
</ui:UXML>
<!-- Cache Invalidation: 2.75x Scale Mobile Refresh - Pitch & Profile Cards -->