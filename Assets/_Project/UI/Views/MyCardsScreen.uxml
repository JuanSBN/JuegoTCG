<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="LiquidGlassNavBar" src="project://database/Assets/_Project/UI/Components/LiquidGlassNavBar.uxml" />
    <Style src="project://database/Assets/_Project/UI/Styles/MyCardsScreen.uss" />

    <ui:VisualElement name="MyCardsScreenContainer" class="screen-container">

        <!-- Header -->
        <ui:VisualElement class="cards-header">
            <ui:Label text="MIS CARTAS" class="cards-title" />

            <!-- Horizontal Filter Bar -->
            <ui:VisualElement class="filter-bar">
                <ui:Button name="FilterPrevBtn" class="filter-arrow-btn">
                    <ui:VisualElement class="filter-arrow-icon" style="background-image: url('project://database/Assets/_Project/Art/UI/ui_chevron_left.png');" />
                </ui:Button>

                <ui:ScrollView name="FilterScrollView" mode="Horizontal" class="filter-scroll" show-horizontal-scroller="false">
                    <ui:Button name="Filter_Album" class="filter-pill">
                        <ui:Label text="Álbum" class="filter-pill-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Recientes" class="filter-pill">
                        <ui:Label text="Recientes" class="filter-pill-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Rareza" class="filter-pill filter-pill-active">
                        <ui:Label text="Rareza" class="filter-pill-text filter-pill-text-active" />
                    </ui:Button>
                    <ui:Button name="Filter_Cantidad" class="filter-pill">
                        <ui:Label text="Cantidad" class="filter-pill-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Nacion" class="filter-pill">
                        <ui:Label text="Nación" class="filter-pill-text" />
                    </ui:Button>
                </ui:ScrollView>

                <ui:Button name="FilterNextBtn" class="filter-arrow-btn">
                    <ui:VisualElement class="filter-arrow-icon" style="background-image: url('project://database/Assets/_Project/Art/UI/ui_chevron_right.png');" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Counter & Search Row -->
            <ui:VisualElement class="meta-row">
                <ui:Label name="CardsCountLabel" text="1,232 cartas" class="cards-count-label" />
                <ui:VisualElement class="search-box">
                    <ui:VisualElement class="search-icon" />
                    <ui:TextField name="SearchField" placeholder-text="Buscar jugador..." class="search-text-field" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Cards Grid Scroll View (2 Columns) -->
        <ui:ScrollView name="CardsScrollView" class="cards-scroll-view" vertical-scroller-visibility="Always">
            <ui:VisualElement name="CardsGrid" class="cards-grid">
                
                <!-- Card 1: Luis Díaz (Mítica) -->
                <ui:Button name="Card_1" class="card-item card-mythic">
                    <ui:VisualElement class="card-avatar-circle avatar-mythic">
                        <ui:Label text="LD" class="card-avatar-initials initials-mythic" />
                    </ui:VisualElement>
                    <ui:Label text="Luis Díaz" class="card-player-name" />
                    <ui:Label text="Mítica ×1" class="card-rarity-badge initials-mythic" />
                </ui:Button>

                <!-- Card 2: Vinicius Jr. (Rara) -->
                <ui:Button name="Card_2" class="card-item card-rare">
                    <ui:VisualElement class="card-avatar-circle avatar-rare">
                        <ui:Label text="VJ" class="card-avatar-initials initials-rare" />
                    </ui:VisualElement>
                    <ui:Label text="Vinicius Jr." class="card-player-name" />
                    <ui:Label text="Rara ×2" class="card-rarity-badge initials-rare" />
                </ui:Button>

                <!-- Card 3: Haaland (Común) -->
                <ui:Button name="Card_3" class="card-item card-common">
                    <ui:VisualElement class="card-avatar-circle avatar-common">
                        <ui:Label text="EH" class="card-avatar-initials initials-common" />
                    </ui:VisualElement>
                    <ui:Label text="Haaland" class="card-player-name" />
                    <ui:Label text="Común ×5" class="card-rarity-badge initials-common" />
                </ui:Button>

                <!-- Card 4: Mbappé (Poco común) -->
                <ui:Button name="Card_4" class="card-item card-uncommon">
                    <ui:VisualElement class="card-avatar-circle avatar-uncommon">
                        <ui:Label text="KM" class="card-avatar-initials initials-uncommon" />
                    </ui:VisualElement>
                    <ui:Label text="Mbappé" class="card-player-name" />
                    <ui:Label text="Poco común ×3" class="card-rarity-badge initials-uncommon" />
                </ui:Button>

                <!-- Card 5: Pedri (Rara) -->
                <ui:Button name="Card_5" class="card-item card-rare">
                    <ui:VisualElement class="card-avatar-circle avatar-rare">
                        <ui:Label text="PE" class="card-avatar-initials initials-rare" />
                    </ui:VisualElement>
                    <ui:Label text="Pedri" class="card-player-name" />
                    <ui:Label text="Rara ×1" class="card-rarity-badge initials-rare" />
                </ui:Button>

                <!-- Card 6: Rodri (Común) -->
                <ui:Button name="Card_6" class="card-item card-common">
                    <ui:VisualElement class="card-avatar-circle avatar-common">
                        <ui:Label text="RO" class="card-avatar-initials initials-common" />
                    </ui:VisualElement>
                    <ui:Label text="Rodri" class="card-player-name" />
                    <ui:Label text="Común ×4" class="card-rarity-badge initials-common" />
                </ui:Button>

                <!-- Card 7: Lamine Yamal (Mítica) -->
                <ui:Button name="Card_7" class="card-item card-mythic">
                    <ui:VisualElement class="card-avatar-circle avatar-mythic">
                        <ui:Label text="LY" class="card-avatar-initials initials-mythic" />
                    </ui:VisualElement>
                    <ui:Label text="Lamine Yamal" class="card-player-name" />
                    <ui:Label text="Mítica ×1" class="card-rarity-badge initials-mythic" />
                </ui:Button>

                <!-- Card 8: Bellingham (Rara) -->
                <ui:Button name="Card_8" class="card-item card-rare">
                    <ui:VisualElement class="card-avatar-circle avatar-rare">
                        <ui:Label text="JB" class="card-avatar-initials initials-rare" />
                    </ui:VisualElement>
                    <ui:Label text="Bellingham" class="card-player-name" />
                    <ui:Label text="Rara ×2" class="card-rarity-badge initials-rare" />
                </ui:Button>

                <!-- Card 9: Salah (Poco común) -->
                <ui:Button name="Card_9" class="card-item card-uncommon">
                    <ui:VisualElement class="card-avatar-circle avatar-uncommon">
                        <ui:Label text="MS" class="card-avatar-initials initials-uncommon" />
                    </ui:VisualElement>
                    <ui:Label text="Salah" class="card-player-name" />
                    <ui:Label text="Poco común ×6" class="card-rarity-badge initials-uncommon" />
                </ui:Button>

                <!-- Card 10: De Bruyne (Rara) -->
                <ui:Button name="Card_10" class="card-item card-rare">
                    <ui:VisualElement class="card-avatar-circle avatar-rare">
                        <ui:Label text="KDB" class="card-avatar-initials initials-rare" />
                    </ui:VisualElement>
                    <ui:Label text="De Bruyne" class="card-player-name" />
                    <ui:Label text="Rara ×1" class="card-rarity-badge initials-rare" />
                </ui:Button>

                <!-- Card 11: Musiala (Común) -->
                <ui:Button name="Card_11" class="card-item card-common">
                    <ui:VisualElement class="card-avatar-circle avatar-common">
                        <ui:Label text="JM" class="card-avatar-initials initials-common" />
                    </ui:VisualElement>
                    <ui:Label text="Musiala" class="card-player-name" />
                    <ui:Label text="Común ×3" class="card-rarity-badge initials-common" />
                </ui:Button>

                <!-- Card 12: Osimhen (Poco común) -->
                <ui:Button name="Card_12" class="card-item card-uncommon">
                    <ui:VisualElement class="card-avatar-circle avatar-uncommon">
                        <ui:Label text="VO" class="card-avatar-initials initials-uncommon" />
                    </ui:VisualElement>
                    <ui:Label text="Osimhen" class="card-player-name" />
                    <ui:Label text="Poco común ×2" class="card-rarity-badge initials-uncommon" />
                </ui:Button>

            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Modular Liquid Glass Navigation Bar -->
        <ui:Instance template="LiquidGlassNavBar" name="BottomNavBar" />

        <!-- Card Zoom / Hero Inspect Modal (Pokémon TCG Pocket Style) -->
        <ui:VisualElement name="CardInspectModal" class="inspect-overlay modal-hidden">
            <!-- Top Controls Bar -->
            <ui:VisualElement class="inspect-top-bar">
                <ui:Label name="InspectTiltHint" text="✦ Mueve el dedo sobre la carta para ver el brillo" class="inspect-tilt-hint" />
                <ui:Button name="InspectCloseBtn" class="inspect-close-btn">
                    <ui:Label text="✕" class="inspect-close-icon-text" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Card Stage (Touch area for 3D Tilt) -->
            <ui:VisualElement name="InspectCardStage" class="inspect-card-stage">
                <ui:VisualElement name="InspectHeroCard" class="inspect-hero-card">
                    <!-- Unified Art Container (Always displays official frame and metadata) -->
                    <ui:VisualElement name="InspectArtContainer" class="inspect-art-container">
                        <!-- Photo or Default Tactical Pitch Background -->
                        <ui:VisualElement name="InspectArtPhoto" class="inspect-art-photo" />

                        <!-- Default Player Avatar (when no player image is available) -->
                        <ui:VisualElement name="InspectPlaceholderAvatar" class="inspect-placeholder-avatar">
                            <ui:Label name="InspectAvatarInitials" text="VO" class="inspect-avatar-initials" />
                        </ui:VisualElement>

                        <!-- Official Rarity Border Frame (RenderTexture / Holo or Static) -->
                        <ui:VisualElement name="InspectArtFrame" class="inspect-art-frame" />

                        <!-- Player Name inside card -->
                        <ui:Label name="InspectPlayerNameFramed" text="Player Name" class="inspect-player-name-framed" />

                        <!-- Bottom Attributes Row: Flag outside left + Stats inside Frame Tab -->
                        <ui:VisualElement class="inspect-bottom-row">
                            <!-- Flag outside the tab on the left -->
                            <ui:VisualElement name="InspectFlagImage" class="inspect-flag-image" />

                            <!-- Frame Tab / Box: Stats inside where team/pos used to be -->
                            <ui:VisualElement name="InspectFrameFooterBox" class="inspect-frame-footer-box">
                                <ui:VisualElement name="InspectStatsGroup" class="inspect-stats-group">
                                    <ui:VisualElement class="inspect-stat-col">
                                        <ui:Label name="InspectStat1Title" text="TIR" class="inspect-stat-title" />
                                        <ui:Label name="InspectStat1Value" text="82" class="inspect-stat-value" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="inspect-stat-col">
                                        <ui:Label name="InspectStat2Title" text="PAS" class="inspect-stat-title" />
                                        <ui:Label name="InspectStat2Value" text="86" class="inspect-stat-value" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="inspect-stat-col">
                                        <ui:Label name="InspectStat3Title" text="DEF" class="inspect-stat-title" />
                                        <ui:Label name="InspectStat3Value" text="45" class="inspect-stat-value" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="inspect-stat-col">
                                        <ui:Label name="InspectStat4Title" text="REG" class="inspect-stat-title" />
                                        <ui:Label name="InspectStat4Value" text="91" class="inspect-stat-value" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Copies Badge (Top Right) -->
                    <ui:Label name="InspectCopiesBadge" text="×1" class="inspect-copies-badge" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Dismiss Hint -->
            <ui:Label text="Toca en cualquier parte para cerrar" class="inspect-dismiss-hint" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>