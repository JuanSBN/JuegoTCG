<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="LiquidGlassNavBar" src="../Components/LiquidGlassNavBar.uxml" />
    <Style src="project://database/Assets/_Project/UI/Styles/TradeScreen.uss" />

    <ui:VisualElement name="TradeScreenRoot" class="screen-container">

        <!-- Header -->
        <ui:VisualElement class="trade-header">
            <ui:Button name="BackBtn" class="back-btn">
                <ui:VisualElement class="back-btn-icon" />
            </ui:Button>
            <ui:Label text="INTERCAMBIO" class="trade-title" />
        </ui:VisualElement>

        <!-- Filter Tabs Row -->
        <ui:VisualElement class="trade-tabs-row">
            <ui:Button name="Tab_Received" class="trade-tab-pill trade-tab-pill-active">
                <ui:Label text="RECIBIDAS" class="trade-tab-label" />
                <ui:VisualElement name="Badge_Received" class="trade-tab-badge">
                    <ui:Label name="BadgeCount_Received" text="2" class="trade-tab-badge-text" />
                </ui:VisualElement>
            </ui:Button>

            <ui:Button name="Tab_Sent" class="trade-tab-pill">
                <ui:Label text="ENVIADAS" class="trade-tab-label" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Scrollable Offers Container -->
        <ui:ScrollView name="TradeScrollView" class="trade-scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
            
            <!-- Cards List -->
            <ui:VisualElement name="TradeCardsList" class="trade-cards-list">

                <!-- Trade Card 1 (Received - MiAmigo_01 - Unread) -->
                <ui:VisualElement name="Card_Trade_1" class="trade-card trade-card-unread">
                    <ui:VisualElement class="trade-card-header">
                        <ui:VisualElement class="trade-avatar-circle">
                            <ui:Label text="MA" class="trade-avatar-text" />
                        </ui:VisualElement>
                        <ui:Label text="MiAmigo_01" class="trade-user-name" />
                        <ui:Label text="hace 2 h" class="trade-time-label" />
                        <ui:VisualElement name="Dot_Trade_1" class="trade-unread-dot" />
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-exchange-row">
                        <ui:VisualElement class="trade-side-col">
                            <ui:Label text="TÚ DAS" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-mythic">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="MÍ" class="trade-token-text" />
                                </ui:VisualElement>
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="trade-swap-icon" />

                        <ui:VisualElement class="trade-side-col trade-side-col-right">
                            <ui:Label text="TÚ RECIBES" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-mythic">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="MÍ" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-actions-row">
                        <ui:Button name="Btn_Accept_1" class="trade-btn-accept">
                            <ui:Label text="ACEPTAR" class="trade-btn-accept-text" />
                        </ui:Button>
                        <ui:Button name="Btn_Reject_1" class="trade-btn-reject">
                            <ui:Label text="RECHAZAR" class="trade-btn-reject-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Trade Card 2 (Received - ElChampion - Unread) -->
                <ui:VisualElement name="Card_Trade_2" class="trade-card trade-card-unread">
                    <ui:VisualElement class="trade-card-header">
                        <ui:VisualElement class="trade-avatar-circle">
                            <ui:Label text="EC" class="trade-avatar-text" />
                        </ui:VisualElement>
                        <ui:Label text="ElChampion" class="trade-user-name" />
                        <ui:Label text="hace 1 d" class="trade-time-label" />
                        <ui:VisualElement name="Dot_Trade_2" class="trade-unread-dot" />
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-exchange-row">
                        <ui:VisualElement class="trade-side-col">
                            <ui:Label text="TÚ DAS" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="trade-swap-icon" />

                        <ui:VisualElement class="trade-side-col trade-side-col-right">
                            <ui:Label text="TÚ RECIBES" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                                <ui:VisualElement class="trade-token trade-token-common">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="CO" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-actions-row">
                        <ui:Button name="Btn_Accept_2" class="trade-btn-accept">
                            <ui:Label text="ACEPTAR" class="trade-btn-accept-text" />
                        </ui:Button>
                        <ui:Button name="Btn_Reject_2" class="trade-btn-reject">
                            <ui:Label text="RECHAZAR" class="trade-btn-reject-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Trade Card 3 (Received - ProPlayer_99 - Read) -->
                <ui:VisualElement name="Card_Trade_3" class="trade-card">
                    <ui:VisualElement class="trade-card-header">
                        <ui:VisualElement class="trade-avatar-circle">
                            <ui:Label text="PP" class="trade-avatar-text" />
                        </ui:VisualElement>
                        <ui:Label text="ProPlayer_99" class="trade-user-name" />
                        <ui:Label text="hace 3 d" class="trade-time-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-exchange-row">
                        <ui:VisualElement class="trade-side-col">
                            <ui:Label text="TÚ DAS" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-uncommon">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="PO" class="trade-token-text" />
                                </ui:VisualElement>
                                <ui:VisualElement class="trade-token trade-token-common">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="CO" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="trade-swap-icon" />

                        <ui:VisualElement class="trade-side-col trade-side-col-right">
                            <ui:Label text="TÚ RECIBES" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-uncommon">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="PO" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-actions-row">
                        <ui:Button name="Btn_Accept_3" class="trade-btn-accept">
                            <ui:Label text="ACEPTAR" class="trade-btn-accept-text" />
                        </ui:Button>
                        <ui:Button name="Btn_Reject_3" class="trade-btn-reject">
                            <ui:Label text="RECHAZAR" class="trade-btn-reject-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Trade Card 4 (Sent - GoldenShot_7) - initially hidden in Received tab -->
                <ui:VisualElement name="Card_Trade_Sent_1" class="trade-card" style="display: none;">
                    <ui:VisualElement class="trade-card-header">
                        <ui:VisualElement class="trade-avatar-circle">
                            <ui:Label text="GS" class="trade-avatar-text" />
                        </ui:VisualElement>
                        <ui:Label text="GoldenShot_7" class="trade-user-name" />
                        <ui:Label text="hace 5 h" class="trade-time-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-exchange-row">
                        <ui:VisualElement class="trade-side-col">
                            <ui:Label text="TÚ DAS" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-mythic">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="MÍ" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="trade-swap-icon" />

                        <ui:VisualElement class="trade-side-col trade-side-col-right">
                            <ui:Label text="TÚ RECIBES" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-actions-row">
                        <ui:Button name="Btn_Cancel_1" class="trade-btn-cancel">
                            <ui:Label text="CANCELAR OFERTA" class="trade-btn-cancel-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Trade Card Sent 2 -->
                <ui:VisualElement name="Card_Trade_Sent_2" class="trade-card" style="display: none;">
                    <ui:VisualElement class="trade-card-header">
                        <ui:VisualElement class="trade-avatar-circle">
                            <ui:Label text="AM" class="trade-avatar-text" />
                        </ui:VisualElement>
                        <ui:Label text="Amigo" class="trade-user-name" />
                        <ui:Label text="hace 1 d" class="trade-time-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-exchange-row">
                        <ui:VisualElement class="trade-side-col">
                            <ui:Label text="TÚ DAS" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="trade-swap-icon" />

                        <ui:VisualElement class="trade-side-col trade-side-col-right">
                            <ui:Label text="TÚ RECIBES" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-common">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="CO" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-actions-row">
                        <ui:Button name="Btn_Cancel_2" class="trade-btn-cancel">
                            <ui:Label text="CANCELAR OFERTA" class="trade-btn-cancel-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Trade Card Sent 3 -->
                <ui:VisualElement name="Card_Trade_Sent_3" class="trade-card" style="display: none;">
                    <ui:VisualElement class="trade-card-header">
                        <ui:VisualElement class="trade-avatar-circle">
                            <ui:Label text="AM" class="trade-avatar-text" />
                        </ui:VisualElement>
                        <ui:Label text="Amigo" class="trade-user-name" />
                        <ui:Label text="hace 2 d" class="trade-time-label" />
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-exchange-row">
                        <ui:VisualElement class="trade-side-col">
                            <ui:Label text="TÚ DAS" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-mythic">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="MÍ" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="trade-swap-icon" />

                        <ui:VisualElement class="trade-side-col trade-side-col-right">
                            <ui:Label text="TÚ RECIBES" class="trade-side-title" />
                            <ui:VisualElement class="trade-tokens-row">
                                <ui:VisualElement class="trade-token trade-token-rare">
                                    <ui:VisualElement class="trade-token-photo" />
                                    <ui:VisualElement class="trade-token-frame" />
                                    <ui:Label text="RA" class="trade-token-text" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="trade-actions-row">
                        <ui:Button name="Btn_Cancel_3" class="trade-btn-cancel">
                            <ui:Label text="CANCELAR OFERTA" class="trade-btn-cancel-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Empty State -->
                <ui:VisualElement name="TradeEmptyState" class="trade-empty-state" style="display: none;">
                    <ui:VisualElement class="trade-empty-icon" />
                    <ui:Label name="EmptyTitle" text="Aún no tienes intercambios." class="trade-empty-title" />
                    <ui:Label name="EmptyDesc" text="Cuando un amigo te proponga un trato, aparecerá aquí." class="trade-empty-desc" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Floating Action Button (FAB) -->
        <ui:Button name="Btn_NewTrade" class="trade-fab">
            <ui:Label text="+ NUEVO INTERCAMBIO" class="trade-fab-text" />
        </ui:Button>

        <!-- ================================================================= -->
        <!-- NUEVO FLUJO DE INTERCAMBIO (FIGMA PANTALLAS 2.5)                   -->
        <!-- ================================================================= -->
        <ui:VisualElement name="NewTradeFlowView" class="trade-flow-view" style="display: none;">
            
            <!-- PASO 0: ELEGIR AMIGO -->
            <ui:VisualElement name="Step_ChooseFriend" class="trade-flow-step" style="display: none;">
                <ui:VisualElement class="trade-step-header">
                    <ui:Button name="Btn_Back_ChooseFriend" class="back-btn">
                        <ui:VisualElement class="back-btn-icon" />
                    </ui:Button>
                    <ui:Label text="ELEGIR AMIGO" class="trade-step-title" />
                </ui:VisualElement>
                
                <ui:Label text="Toca un amigo para continuar" class="trade-step-subtitle-static" />
                
                <ui:ScrollView name="ChooseFriendScrollView" class="trade-step-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="ChooseFriendEmpty" class="trade-friend-cards-empty" style="display: none;">
                        <ui:Label name="ChooseFriendEmptyText" text="Aún no tienes amigos agregados. Agrega amigos desde la sección Comunidad para intercambiar cartas con ellos." class="trade-empty-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ChooseFriendList" class="choose-friend-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- PASO 1: ELIGE QUÉ DAR -->
            <ui:VisualElement name="Step_GiveCards" class="trade-flow-step" style="display: none;">
                <ui:VisualElement class="trade-step-header-with-steps">
                    <ui:Button name="Btn_Back_GiveCards" class="back-btn">
                        <ui:VisualElement class="back-btn-icon" />
                    </ui:Button>
                    <ui:VisualElement class="trade-step-header-titles">
                        <ui:Label text="ELIGE QUÉ DAR" class="trade-step-title" />
                        <ui:Label name="GiveCardsSubtitle" text="Con Amigo" class="trade-step-subtitle" />
                    </ui:VisualElement>
                    <ui:VisualElement class="trade-step-indicator-box">
                        <ui:VisualElement class="trade-step-pills-row">
                            <ui:VisualElement class="trade-step-bar trade-step-bar-active" />
                            <ui:VisualElement class="trade-step-bar" />
                        </ui:VisualElement>
                        <ui:Label text="PASO 1 DE 2" class="trade-step-indicator-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Counter badge / prompt -->
                <ui:VisualElement class="trade-counter-row">
                    <ui:Label name="GiveCardsCounter" text="Elige al menos 1 carta" class="trade-counter-text" />
                </ui:VisualElement>

                <!-- Filter pills row -->
                <ui:VisualElement class="trade-filters-row">
                    <ui:Button name="Filter_Give_Album" class="pick-filter-chip pick-filter-chip-active">
                        <ui:Label text="Álbum" class="pick-filter-chip-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Give_Rarity" class="pick-filter-chip">
                        <ui:Label text="Rareza" class="pick-filter-chip-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Give_Count" class="pick-filter-chip">
                        <ui:Label text="Cantidad" class="pick-filter-chip-text" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="trade-divider" />

                <!-- Grid of owned cards -->
                <ui:ScrollView name="GiveCardsScrollView" class="trade-step-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="GiveCardsGrid" class="trade-pick-grid" />
                </ui:ScrollView>

                <!-- CTA Button -->
                <ui:VisualElement class="trade-bottom-cta-container">
                    <ui:Button name="Btn_GiveContinue" class="btn-trade-cta btn-trade-cta-disabled">
                        <ui:Label text="CONTINUAR" class="btn-trade-cta-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- PASO 2: ELIGE QUÉ RECIBIR -->
            <ui:VisualElement name="Step_ReceiveCards" class="trade-flow-step" style="display: none;">
                <ui:VisualElement class="trade-step-header-with-steps">
                    <ui:Button name="Btn_Back_ReceiveCards" class="back-btn">
                        <ui:VisualElement class="back-btn-icon" />
                    </ui:Button>
                    <ui:VisualElement class="trade-step-header-titles">
                        <ui:Label text="ELIGE QUÉ RECIBIR" class="trade-step-title" />
                        <ui:Label name="ReceiveCardsSubtitle" text="Cartas de Amigo" class="trade-step-subtitle" />
                    </ui:VisualElement>
                    <ui:VisualElement class="trade-step-indicator-box">
                        <ui:VisualElement class="trade-step-pills-row">
                            <ui:VisualElement class="trade-step-bar trade-step-bar-active" />
                            <ui:VisualElement class="trade-step-bar trade-step-bar-active" />
                        </ui:VisualElement>
                        <ui:Label text="PASO 2 DE 2" class="trade-step-indicator-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Counter badge / prompt -->
                <ui:VisualElement class="trade-counter-row">
                    <ui:Label name="ReceiveCardsCounter" text="Elige al menos 1 carta" class="trade-counter-text" />
                </ui:VisualElement>

                <!-- Filter pills row -->
                <ui:VisualElement class="trade-filters-row">
                    <ui:Button name="Filter_Receive_Album" class="pick-filter-chip pick-filter-chip-active">
                        <ui:Label text="Álbum" class="pick-filter-chip-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Receive_Rarity" class="pick-filter-chip">
                        <ui:Label text="Rareza" class="pick-filter-chip-text" />
                    </ui:Button>
                    <ui:Button name="Filter_Receive_Count" class="pick-filter-chip">
                        <ui:Label text="Cantidad" class="pick-filter-chip-text" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Strip: what you're giving + edit button -->
                <ui:VisualElement class="trade-giving-strip">
                    <ui:Label text="DAS" class="trade-giving-strip-tag" />
                    <ui:Label name="GivingStripCardName" text="-" class="trade-giving-strip-name" />
                    <ui:Button name="Btn_EditGivenCard" class="trade-giving-strip-edit">
                        <ui:Label text="Editar" class="trade-giving-strip-edit-text" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="trade-divider" />

                <!-- Grid of friend cards -->
                <ui:ScrollView name="ReceiveCardsScrollView" class="trade-step-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="ReceiveCardsEmpty" class="trade-friend-cards-empty" style="display: none;">
                        <ui:Label name="ReceiveCardsEmptyText" text="Este amigo aún no tiene cartas para intercambiar." class="trade-empty-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ReceiveCardsGrid" class="trade-pick-grid" />
                </ui:ScrollView>

                <!-- CTA Button -->
                <ui:VisualElement class="trade-bottom-cta-container">
                    <ui:Button name="Btn_ReceiveReview" class="btn-trade-cta btn-trade-cta-disabled">
                        <ui:Label text="REVISAR OFERTA  ›" class="btn-trade-cta-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- PASO 3: CONFIRMAR OFERTA -->
            <ui:VisualElement name="Step_ConfirmOffer" class="trade-flow-step" style="display: none;">
                <ui:VisualElement class="trade-step-header">
                    <ui:Button name="Btn_Back_ConfirmOffer" class="back-btn">
                        <ui:VisualElement class="back-btn-icon" />
                    </ui:Button>
                    <ui:Label text="CONFIRMAR OFERTA" class="trade-step-title" />
                </ui:VisualElement>

                <ui:ScrollView name="ConfirmOfferScrollView" class="trade-step-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <!-- Offer preview card -->
                    <ui:VisualElement class="confirm-offer-card">
                        
                        <!-- Friend Header Strip -->
                        <ui:VisualElement class="confirm-friend-header">
                            <ui:VisualElement class="confirm-avatar-circle">
                                <ui:Label name="ConfirmFriendInitials" text="GS" class="confirm-avatar-text" />
                            </ui:VisualElement>
                            <ui:VisualElement class="confirm-friend-info">
                                <ui:Label name="ConfirmFriendName" text="GoldenShot_7" class="confirm-friend-name" />
                                <ui:Label name="ConfirmFriendLevel" text="Nivel 24" class="confirm-friend-level" />
                            </ui:VisualElement>
                            <ui:VisualElement class="confirm-status-badge">
                                <ui:Label text="Pendiente" class="confirm-status-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Cards Exchange Body -->
                        <ui:VisualElement class="confirm-exchange-body">
                            
                            <!-- Tú das -->
                            <ui:VisualElement class="confirm-trade-side">
                                <ui:Label text="TÚ DAS" class="confirm-side-title" />
                                <ui:VisualElement name="ConfirmGiveCardBox" class="confirm-card-preview-box">
                                    <ui:VisualElement name="ConfirmGiveCardPhoto" class="confirm-card-photo" />
                                    <ui:VisualElement name="ConfirmGiveCardFrame" class="confirm-card-frame" />
                                    <ui:VisualElement name="ConfirmGiveCardAvatar" class="confirm-card-avatar">
                                        <ui:Label name="ConfirmGiveCardInitials" text="PE" class="confirm-card-avatar-text" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label name="ConfirmGiveCardName" text="Pedri" class="confirm-card-name" />
                            </ui:VisualElement>

                            <!-- Swap icon -->
                            <ui:VisualElement class="confirm-swap-row">
                                <ui:VisualElement class="confirm-swap-line" />
                                <ui:VisualElement class="confirm-swap-circle">
                                    <ui:Label text="⇅" class="confirm-swap-arrows" />
                                </ui:VisualElement>
                                <ui:VisualElement class="confirm-swap-line" />
                            </ui:VisualElement>

                            <!-- Tú recibes -->
                            <ui:VisualElement class="confirm-trade-side">
                                <ui:Label text="TÚ RECIBES" class="confirm-side-title" />
                                <ui:VisualElement name="ConfirmReceiveCardBox" class="confirm-card-preview-box">
                                    <ui:VisualElement name="ConfirmReceiveCardPhoto" class="confirm-card-photo" />
                                    <ui:VisualElement name="ConfirmReceiveCardFrame" class="confirm-card-frame" />
                                    <ui:VisualElement name="ConfirmReceiveCardAvatar" class="confirm-card-avatar">
                                        <ui:Label name="ConfirmReceiveCardInitials" text="EH" class="confirm-card-avatar-text" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label name="ConfirmReceiveCardName" text="Haaland" class="confirm-card-name" />
                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Notice text -->
                    <ui:Label text="Tu amigo recibirá una notificación y podrá aceptar o rechazar la oferta." class="confirm-disclaimer-text" />

                    <!-- Action buttons -->
                    <ui:VisualElement class="confirm-actions-col">
                        <ui:Button name="Btn_SubmitOffer" class="btn-confirm-submit">
                            <ui:Label text="ENVIAR OFERTA" class="btn-confirm-submit-text" />
                        </ui:Button>
                        <ui:Button name="Btn_CancelConfirm" class="btn-confirm-cancel">
                            <ui:Label text="CANCELAR" class="btn-confirm-cancel-text" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Modal: Feedback / Alerta de Intercambio -->
        <ui:VisualElement name="TradeFeedbackModal" class="modal-backdrop" style="display: none;">
            <ui:VisualElement class="modal-card">
                <ui:Label name="TradeFeedbackTitle" text="INTERCAMBIO" class="modal-header-title" />
                <ui:Label name="TradeFeedbackMessage" text="" class="trade-feedback-message" />
                <ui:VisualElement class="modal-actions-row">
                    <ui:Button name="Btn_CloseTradeFeedback" class="btn-confirm-trade" style="width: 100%; margin-right: 0;">
                        <ui:Label text="ENTENDIDO" class="btn-confirm-trade-text" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Liquid Glass Bottom Nav -->
        <ui:Instance template="LiquidGlassNavBar" name="BottomNavBar" />

    </ui:VisualElement>
</ui:UXML>